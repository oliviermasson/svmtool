                        #    -and (($PrimaryFpolicyEnginePrimaryServers -ne $null) -and ($SecondaryFpolicyEnginePrimaryServers -ne $null))) `
                        #    -or (($PrimaryFpolicyEngineSecondaryServers_str -ne $SecondaryFpolicyEngineSecondaryServers_str) `
