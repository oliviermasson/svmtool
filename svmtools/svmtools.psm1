#############################################################################################
Function get_local_cred ([string]$myCredential,[switch]$ResetPassword,[switch]$ADcred) {

    if($Global:WfaIntegration){
        Write-LogDebug "get_local_cred: get from WFA - [$myCredential]"
        try{
            $cred = Get-WfaCredentials $myCredential
            return $cred
        }catch{
			Write-LogError "ERROR: failed to get credentials for $myCredential in WfaIntegration mode | Exit" 
        	clean_and_exit 1            
        }
    }

	# Manage Default cDOT Credentials
	Write-LogDebug "[$myCredential]"
	$Global:CRED_CONF_FILE=$Global:CRED_CONFDIR + $myCredential + '.cred'

	if ( $ResetPassword.IsPresent ) { 
        if(-not $Global:NonInteractive){
        	$status = set_cred_from_cli $myCredential $Global:CRED_CONF_FILE
		    if ( $status -eq $False ) {
			    Write-LogError "ERROR: Unable to set your credentials for $myCredential Exit" 
        		    clean_and_exit 1
		    }
        }else{
            Write-LogError "ERROR: Unable to reset your credentials for $myCredential in NonInteractive Mode SKIP" 
        }
	}

    if($null -ne $Global:ActiveDirectoryCredentials){
        Write-LogDebug "ActiveDirectoryCredentials has been provided. Will use it for this session, instead of the one saved into file"
        $cred = $Global:ActiveDirectoryCredentials
        #$login = $cred.Username
    }else{
        $cred=read_cred_from_file $Global:CRED_CONF_FILE
    }
    if( ($null -eq $cred) -and ($Global:Run_Mode -eq "UpdateDR") -and ($ADcred.IsPresent)){
        Write-LogWarn "No Credential available for [$myCredential]. Will bypass associated operations"
        return "BYPASS_FOR_ADCRED"
    }
	if ( $null -eq $cred ) 
    {
        if( -not $Global:NonInteractive -or ( $null -ne $Global:ActiveDirectoryCredentials ) ){
            $status = set_cred_from_cli $myCredential $Global:CRED_CONF_FILE
		    $cred=read_cred_from_file $Global:CRED_CONF_FILE
		    if ( $null -eq $cred ) 
            {
			    Write-LogError "ERROR: Unable to set your credentials for $myCredential Exit" 
        	    clean_and_exit 1
		    }
        }else{
            Write-LogError "ERROR: Unable to set your credentials for $myCredential in NonInteractive Mode | Exit" 
        	clean_and_exit 1
        }
	}
	return $cred
}

#############################################################################################
Function set_cred_from_cli ([string]$myCredential, [string]$cred_file ) {
	Write-Log "Set Credential for [$myCredential]"
    if($null -ne $Global:ActiveDirectoryCredentials){
        $cred = $Global:ActiveDirectoryCredentials
        $login = $cred.Username
    }else{
        $login = Read-Host "[$myCredential] Enter login"
        do{
            $ReEnter=$false
            #$password = Read-Host "[$myCredential] Enter Password" -AsSecureString
            $pass1=Read-Host "[$myCredential] Enter Password" -AsSecureString
            $pass2=Read-Host "[$myCredential] Confirm Password" -AsSecureString
            $pwd1_text = [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($pass1))
            $pwd2_text = [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($pass2))
            if ($pwd1_text -ceq $pwd2_text) {
                Write-LogDebug "Passwords matched"
            } 
            else{
                Write-LogWarn "[$myCredential] Error passwords does not match. Please Re-Enter"
                $ReEnter=$True
            }
        }while($ReEnter -eq $True)
        $cred =  New-Object -TypeName System.Management.Automation.PSCredential -ArgumentList $login,$pass1
    }
		
	$save_password=$cred.Password | ConvertFrom-SecureString
	Write-Output "login=${login}" > $cred_file
	Write-Output "password=${save_password}" >> $cred_file
	return $true
}

#############################################################################################
Function connect_cluster (
	[string]$myController,
	[System.Management.Automation.PSCredential]$myCred,
	[Int32]$myTimeout) {

Try {

    if($Global:WfaIntegration){
        Write-LogDebug "Connect-WfaCluster $myController"
		$NcController =  Connect-WfaCluster $myController -ErrorVariable ErrorVar
        if ( $? -ne $True ) { throw "ERROR: Connect-WfaCluster failed [$ErrorVar]" }
        return $NcController
    }

	#Write-LogDebug "Test-Connection -Count 1 -ComputerName $myController -Quiet"
	#if ( ( Test-Connection -Count 1 -ComputerName $myController -Quiet ) -eq $False ) {
	#	throw "ERROR: ICMP Test-Connection [$myController] failed [$ErrorVar]"
	#}
	$Global:TimeoutMilliSeconds = $myTimeout * 1000

	if ( $HTTP ) {
		Write-LogDebug "Connect-NcController $myController -Credential $myCred -HTTP -Timeout $Global:TimeoutMilliSeconds"
		$NcController =  Connect-NcController $myController -Credential $myCred -HTTP -Timeout $Global:TimeoutMilliSeconds  -ErrorVariable ErrorVar
	} else {
		Write-LogDebug "Connect-NcController $myController -Credential $myCred -HTTPS -Timeout $Global:TimeoutMilliSeconds"
		$NcController =  Connect-NcController $myController -Credential $myCred -HTTPS -Timeout $Global:TimeoutMilliSeconds  -ErrorVariable ErrorVar
	}
	if ( $? -ne $True ) { throw "ERROR: Connect-NcController failed [$ErrorVar]" }
	return $NcController 
}

Catch {
	handle_error $_ $myController
	return $false
}
}

