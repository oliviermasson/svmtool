            $ShareCount=$SharesListSource.Count
            Write-LogDebug "[$workon] there is [$ShareCount] share(s) availabe in source backup files"
        }else{
            $Return=$False
            $filepath=$($Global:JsonPath+"Get-NcCifsShare.json")
