#############################################################################################
Function wait_cifs_modify_job (
    [NetApp.Ontapi.Filer.C.NcController] $myController)
{
    
    $isTimeout = $False
    $StartTime = Get-Date
    $JobList=Get-NcJob -Controller $myController
    $CIFSModifyingJob=$JobList | Where-Object {$_.JobName -match "CIFS Server Modify"}
	if($null -eq $CIFSModifyingJob){
        Write-LogDebug "no CIFS modify Job running"
        return $True
    }
	$CIFSJobId=$CIFSModifyingJob.JobId
	Write-LogDebug "CIFS modify Job is running with Id [$CIFSJobId]"
    do {
        $JobDetail=Get-NcJob -JobId $CIFSModifyingJob.JobId -Controller $myController 
        $CurrentTime=Get-date
        $Global:TimeoutTime = ($CurrentTime - $StartTime).TotalSeconds
        if ( $Global:TimeoutTime -gt $Global:STOP_TIMEOUT ) {
            $isTimeOut=$true
        }	
        Start-Sleep 2
		if($JobDetail.JobState -match "Failure"){
			Write-LogDebug "CIFS modify job failure"
            return $False
		}
    } while ( ($JobDetail.JobState -ne "Success") -and ($isTimeOut -eq $False) )
    if($isTimeout){
		Write-LogDebug "CIFS modify job timeout"
        return $False
    }else{
		Write-LogDebug "CIFS modify job finished successfully"
        return $True
    }
}

#############################################################################################
Function migrate_cifs_server (
    [NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
	[NetApp.Ontapi.Filer.C.NcController] $mySecondaryController,
    [string] $myPrimaryVserver,
	[string] $mySecondaryVserver,
    [switch] $NoInteractive) {
try{    
    $Return = $True
    Write-LogDebug "start migrate_cifs_server"
    Write-LogDebug "Get-NcCifsServer -VserverContext $myPrimaryVserver -Controller $myPrimaryController"
    $PrimaryCIFSserver=Get-NcCifsServer -VserverContext $myPrimaryVserver -Controller $myPrimaryController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
    if ($null -eq $PrimaryCIFSserver){Write-LogDebug "No CIFS server, skip"; return $Return}
    

    $PrimaryCIFSidentity=$PrimaryCIFSserver.CIFSServer
    $PrimaryCIFSdomain=$PrimaryCIFSserver.Domain
    $PrimaryCIFSOU=$PrimaryCIFSserver.OrganizationalUnit
    $PrimaryClusterName = $myPrimaryController.Name
    $SecondaryClusterName=$mySecondaryController.Name
    if($Global:InsideMCC -eq $True){
    ###############################################################################
    ###### Migration inside a Metrocluster
        
        ###### 1 backup LIF, cifsserver, shares & symlinks from Source SVM
        
        
        # * backup_CIFSsymlink
        # before changing CIFS server name, we need to backup & remove all cifs symlink
        #Write-LogDebug "ActivateDR in CIFS Modify mode with PreserveIdentity"
        Write-LogDebug "Backup all CIFS Symlink from current passive Vserver [$myPrimaryVserver]"
        if ( ($ret=Save_Cifs_Symlink_To_JSON -myController $myPrimaryController -myVserver $myPrimaryVserver ) -eq $False){
            Throw "ERROR: Failed to backup CIFS Symlink"    
        }

        # * backup_lif
        $PrimaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $myPrimaryVserver -DataProtocols cifs,nfs,none,iscsi -Controller $NcCurrentActiveCtrl  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        $SecondaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $mySecondaryVserver -DataProtocols cifs,nfs,none,iscsi -Controller $mySecondaryController  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        if ( ($ret=Save_LIF_To_JSON -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryNetList $PrimaryInterfaceList -mySecondaryNetList $SecondaryInterfaceList -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver) -eq $False){
            Write-Log "Failed to Backup LIF details to JSON"
            return $False
        }

        # * backup CIFS
        $SecondaryCifsServer=Get-NcCifsServer  -VserverContext $mySecondaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
        if ( ($ret=Save_CIFS_To_JSON -myPrimaryController $myPrimaryController `
                                    -mySecondaryController $mySecondaryController `
                                    -myPrimaryCIFS $PrimaryCifsServer `
                                    -mySecondaryCIFS $SecondaryCifsServer `
                                    -myPrimaryVserver $myPrimaryVserver `
                                    -mySecondaryVserver $mySecondaryVserver) -eq $False){
            Write-Log "Failed to Backup CIFS Server details to JSON"
            return $False
        }

        ###### 2 Remove source vserver

        if ( ( remove_vserver_peer -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
            Write-LogError "ERROR: remove_vserver_peer failed" 
            return $false
        }

        if ( ( $ret = remove_vserver_source -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver) -eq $False ) {
            Write-LogError "ERROR: remove_vserver_dr: Unable to remove vserver [$myPrimaryVserver]" 
            clean_and_exit 1
        }
        $Global:SVMSourceDeleted=$True

        $StartTime=Get-Date
        $Good=$false
        Write-Log "Wait deletion of SVM [$myPrimaryVserver-mc] on Cluster [$mySecondaryController]"
        Write-LogDebug "Wait deletion of SVM [$myPrimaryVserver-mc] on Cluster [$mySecondaryController]"
        while( ($Good -eq $false) ){
            Start-Sleep 1
            Write-LogDebug "Check if $myPrimaryVserver-mc is completely deleted on Secondary Cluster [$mySecondaryController]"
            Write-LogDebug "Get-NcVserver -Vserver $myPrimaryVserver-mc -Controller $mySecondaryController"
            $ret=Get-NcVserver -Vserver $($myPrimaryVserver+"-mc") -Controller $mySecondaryController -ErrorVariable ErrorVar
            if ( $? -ne $True ) {
                throw "ERROR: Get-NcVserver failed [$ErrorVar]"
            }
            if($null -eq $ret){$Good=$True}
            $CurrentTime=Get-date
            $Global:TimeoutTime = ($CurrentTime - $StartTime).TotalSeconds
            if ( $Global:TimeoutTime -gt $Global:STOP_TIMEOUT ) {
                $Return = $false
                throw "ERROR: Timeout waiting Deletion of $myPrimaryVserver-mc"
            }
        }
        Write-Log "SVM [$myPrimaryVserver-mc] deleted on Cluster [$mySecondaryController]"
        Write-LogDebug "SVM [$myPrimaryVserver-mc] deleted on Cluster [$mySecondaryController]"

        if($Global:UseCifsDeleteMethod.IsPresent -eq $True){
            ###### 3 Delete Temporary CIFS on secondary SVM

            Write-LogDebug "Remove all CIFS Symlink on current passive Vserver [$mySecondaryVserver]"
            Write-LogDebug "Get-NcCifsSymlink -VserverContext $mySecondaryVserver -Controller $mySecondaryController | Remove-NcCifsSymlink -Controller $mySecondaryController -VserverContext $mySecondaryVserver"
            Get-NcCifsSymlink -VserverContext $mySecondaryVserver -Controller $mySecondaryController | Remove-NcCifsSymlink -Controller $mySecondaryController -VserverContext $mySecondaryVserver -Confirm:$False
            Write-Log "[$mySecondaryVserver] Recreate CIFS server with identity name [$PrimaryCIFSidentity]"
            Write-LogDebug "Remove-NcCifsServer -ForceAccountDelete -VserverContext $mySecondaryVserver -Controller $mySecondaryController"
            $out=Remove-NcCifsServer -ForceAccountDelete -VserverContext $mySecondaryVserver -Controller $mySecondaryController -Confirm:$False -ErrorVariable ErrorVar

            ###### 4 Delete existing LIF on secondary SVM

            Get-NcNetInterface -VserverContext $mySecondaryVserver -Controller $mySecondaryController | ForEach-Object {
                $lif=$_
                $lifName=$lif.InterfaceName
                Write-LogDebug "Remove-NcNetInterface -Name $lifName -Vserver $mySecondaryVserver -Controller $mySecondaryController"
                Remove-NcNetInterface -Name $lifName -Vserver $mySecondaryVserver -Controller $mySecondaryController -Confirm:$False
            }

            ###### 5 restore LIFs, CIFSServer Options, CIFS Shares and CIFS Symlinks

            if ( ( $ret= restore_object -myPrimaryController $myPrimaryController `
                -mySecondaryController $mySecondaryController `
                -myPrimaryVserver $myPrimaryVserver `
                -mySecondaryVserver $mySecondaryVserver `
                -workOn $mySecondaryVserver `
                -ForceRestoreOriginal `
                -objects @("Lifs","CifsServer","NetBios","Shares","Symlinks") ) -ne $True ) {
                    Write-LogError "ERROR : Failed to restore all objects on [$mySecondaryVserver]"
                    #clean_and_exit 1
                }
        
        }else{
            ###### Only modify LIF and CIFS on secondary to keep all CIFS shares that already exists on secondary
            Write-LogDebug "Work with CIFS modify method"

            # * set_lif_dst_with_source_identity
            # modify active LIF on secondary with primary settings
            Write-Log "[$mySecondaryVserver] Modify LIF"
            if( ($ret=Set_LIF_from_JSON -ToNcController $mySecondaryController -ToVserver $mySecondaryVserver -fromSrc) -eq $False ){
                Throw "ERROR: Failed to set IP address on [$mySecondaryVserver]"	
            }

            # * CIFS_modif_dest_to_source_name
            # add new cifs server with primary identity on active svm
            Write-Log "[$mySecondaryVserver] Modify existing CIFS server"
            if( ($ret=Set_CIFS_from_JSON -ToNcController $mySecondaryController -ToVserver $mySecondaryVserver -fromSrc) -eq $False ){
                Throw "ERROR: Failed to set new CIFS server on [$mySecondaryVserver]"
            }
        }

    }else{
    ###############################################################################
    ###### Migration between two different cluster outside any Metrocluster

        ###### 1 backup LIF, cifsserver, shares & symlinks from Source SVM
        
        Write-LogDebug "use Config File [$Global:CONFFILE]"
        $read_conf = read_config_file $Global:CONFFILE
        $myPrimaryControllerName=$myPrimaryController.Name
        
        $BACKUP_FOLDER=$read_conf.SVMTOOL_DB
        if($BACKUP_FOLDER -notmatch $("\\"+$myPrimaryControllerName+"$")){
            Write-LogDebug "Backup directory [$BACKUP_FOLDER] does not contains subfolder with Cluster name [$myPrimaryControllerName]"
            $BACKUP_FOLDER+=$("\"+$myPrimaryControllerName)
        }else{
            Write-LogDebug "Backup directory [$BACKUP_FOLDER] already contains subfolder with Cluster name [$myPrimaryControllerName]"    
        }
        if(($PSVersionTable.PSVersion.Major -lt 7) -or $IsWindows){$BACKUP_FOLDER=$BACKUP_FOLDER -replace "/","\"}
        else{$BACKUP_FOLDER=$BACKUP_FOLDER -replace "\\","/"}
        Write-LogDebug "SVMTOOL Backup directory:  [$BACKUP_FOLDER]"
        $BackupDate = Get-Date -UFormat "%Y%m%d%H%M%S"
        if(($PSVersionTable.PSVersion.Major -lt 7) -or $IsWindows){
            $Global:JsonPath = $($BACKUP_FOLDER + "\" + $myPrimaryVserver + "\" + $BackupDate + "\")
        }else{
            $Global:JsonPath = $($BACKUP_FOLDER + "/" + $myPrimaryVserver + "/" + $BackupDate + "/")
        }
        Write-LogDebug "[$myPrimaryVserver] Backup Folder is [$Global:JsonPath]"
        check_create_dir -FullPath $($Global:JsonPath + "backup.json") -Vserver $myPrimaryVserver | Out-Null


        # backup LIF ################################################################################################################################################################
        Write-Log "[$myPrimaryVserver] Backup LIF Object"
        Write-LogDebug "create_lif_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver -Backup $True -Restore $False"
        $ret=create_lif_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver -Backup $True -Restore $False
        if ($ret.count -gt 0){
            if ($ret[0] -ne $True){ Write-LogError "ERROR: Failed to backup all LIF" ; $Return = $True }
        }else{
            if ($ret -ne $True){ Write-LogError "ERROR: Failed to backup all LIF" ; $Return = $True }
        }


        # backup CIFS server ################################################################################################################################################################
        Write-Log "[$myPrimaryVserver] Backup CIFS Server Object"
        Write-LogDebug "create_update_CIFS_server_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver -Backup $True -Restore $False"
        if ( ( $ret=create_update_CIFS_server_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver -Backup $True -Restore $False ) -ne $True ) {	Write-LogError "ERROR: create_update_CIFS_server_dr" ; $Return = $False } 
        Write-LogDebug "update_CIFS_server_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver  -Backup $True -Restore $False"
        $ret=update_CIFS_server_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $myPrimaryVserver  -Backup $True -Restore $False
        if ( $? -ne $True ) {
            Write-LogWarn "Some CIFS options has not been backup on [$myPrimaryVserver]"    
        }


        ###### 2 Stop CIFS server on source vserver

        Write-Log "[$myPrimaryVserver] Stop CIFS server"
        Write-LogDebug "stop-NcCifsServer -VserverContext $myPrimaryVserver -Controller $myPrimaryController -Confirm:$False"
        $out = Stop-NcCifsServer -VserverContext $myPrimaryVserver -Controller $myPrimaryController  -ErrorVariable ErrorVar -Confirm:$False
        if ( $? -ne $True ) {
            Write-LogError "ERROR: Failed to disable CIFS on Vserver [$myPrimaryVserver]" 
            $Return = $False
        }

        ###### 3 Modify source CIFS server with tmp_before_migrate name

        $ADCred=get_local_cred($PrimaryCIFSdomain)

        $Temporary_CIFS_server_identity="tmp_for_migrate" # Max 15 chars for netbios name
        Write-Log "[$myPrimaryVserver] Set CIFS server with a temporary name [$Temporary_CIFS_server_identity] on Cluster [$myPrimaryController]"
        Write-LogDebug "Set-NcCifsServer -AdministrativeStatus down -ForceAccountOverwrite -CifsServer $Temporary_CIFS_server_identity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $myPrimaryVserver -controller $myPrimaryController"
        $CifsServerInformations=Set-NcCifsServer -AdministrativeStatus "down" -ForceAccountOverwrite -CifsServer $Temporary_CIFS_server_identity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar  -Confirm:$False
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcCifsServer rename failed [$ErrorVar]" }
       
        # Analyse CIFS Job
        if( (wait_cifs_modify_job -myController $myPrimaryController) -eq $False){
            throw "ERROR: a CIFS Modifying Job is running too long or Failed"
        }

        $NetBiosAliaseList=$CifsServerInformations.NetbiosAliases
        Write-Log "[$myPrimaryVserver] Remove NetBios Aliases"
        $out=Set-NcCifsServer -AdministrativeStatus "down" -CifsServer $Temporary_CIFS_server_identity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar  -Confirm:$False -RemoveNetbiosAlias $NetBiosAliaseList
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcCifsServer failed to remove NetBios Aliases [$ErrorVar]" }
        
        # Analyse CIFS Job
        if( (wait_cifs_modify_job -myController $myPrimaryController) -eq $False){
            throw "ERROR: a CIFS Modifying Job is running too long or Failed"
        }

        Write-Log "[$myPrimaryVserver] Modify existing CIFS symlink with new identity [$Temporary_CIFS_server_identity]"
        $out = Get-NcCifsSymlink -VserverContext $myPrimaryVserver -Controller $myPrimaryController -ErrorVariable ErrorVar | Set-NcCifsSymlink -CifsServer $Temporary_CIFS_server_identity -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $True ; Write-LogError "ERROR: Set-NcCifsSymlink failed [$ErrorVar]" }

        ###### 4 Disable LIF on source Vserver

        Write-Log "Disable LIF on source SVM"
        if (($ret=set_all_lif -mySecondaryVserver $myPrimaryVserver -myPrimaryVserver $myPrimaryVserver -mySecondaryController $myPrimaryController -myPrimaryController $myPrimaryController -state down -Force) -ne $True ) {
            Write-LogError "ERROR: Failed to set all lif up on [$myPrimaryVserver]"
            clean_and_exit 1
        }

        ###### 5 Restore LIF from source to dest

        if ( ( $ret= restore_object -myPrimaryController $myPrimaryController `
                -mySecondaryController $mySecondaryController `
                -myPrimaryVserver $myPrimaryVserver `
                -mySecondaryVserver $mySecondaryVserver `
                -workOn $mySecondaryVserver `
                -ForceRestoreOriginal `
                -objects @("Lifs") ) -ne $True ) {
                    Write-LogError "ERROR : Failed to restore all objects on [$mySecondaryVserver]"
                    #clean_and_exit 1
                }

        ###### 6 Modify dest CIFS server with source's name

        Write-Log "[$mySecondaryVserver] Stop CIFS server"
        Write-LogDebug "stop-NcCifsServer -VserverContext $mySecondaryVserver -Controller $mySecondaryController -Confirm:$False"
        $out = Stop-NcCifsServer -VserverContext $mySecondaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar -Confirm:$False
        if ( $? -ne $True ) {
            Write-LogError "ERROR: Failed to disable CIFS on Vserver [$mySecondaryVserver]" 
            $Return = $False
        }

        Write-Log "[$mySecondaryVserver] Set CIFS server up with identity of [$myPrimaryVserver] : [$PrimaryCIFSidentity]"
        Write-LogDebug "Set-NcCifsServer -AdministrativeStatus up -ForceAccountOverwrite -CifsServer $PrimaryCIFSidentity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $mySecondaryVserver -controller $mySecondaryController"
        $out=Set-NcCifsServer -AdministrativeStatus "up" -ForceAccountOverwrite -CifsServer $PrimaryCIFSidentity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar  -Confirm:$False
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcCifsServer rename failed [$ErrorVar]" }
        
        # Analyse CIFS Job
        if( (wait_cifs_modify_job -myController $mySecondaryController) -eq $False){
            throw "ERROR: a CIFS Modifying Job is running too long or Failed"
        }

        if($null -ne $NetBiosAliaseList -and $NetBiosAliaseList.count -ge 1){
            Write-Log "[$mySecondaryVserver] Set CIFS NetBios Aliases"
            $out=Set-NcCifsServer -CifsServer $PrimaryCIFSidentity -Domain $PrimaryCIFSdomain -AdminCredential $ADCred -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar -AddNetbiosAlias $NetBiosAliaseList -Confirm:$False 
        }
        
        # Analyse CIFS Job
        if( (wait_cifs_modify_job -myController $mySecondaryController) -eq $False){
            throw "ERROR: a CIFS Modifying Job is running too long or Failed"
        }

        ###### 7 Modify dest CIFS symlink server name with source's name

        Write-Log "[$mySecondaryVserver] Modify existing CIFS symlink with new identity [$PrimaryCIFSidentity]"
        $out = Get-NcCifsSymlink -VserverContext $mySecondaryVserver -Controller $mySecondaryController -ErrorVariable ErrorVar | Set-NcCifsSymlink -CifsServer $PrimaryCIFSidentity -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $True ; Write-LogError "ERROR: Set-NcCifsSymlink failed [$ErrorVar]" }

        $ASK_WAIT='y'
        if($Global:DeleteSource -eq $False){
            $ASK_WAIT = Read-HostOptions -question "[$myPrimaryVserver] Do you want to delete SVM on source cluster [$PrimaryClusterName] ?" -options "y/n" -default $defaultanswer
        }
        if ($ASK_WAIT -eq 'y') {
            # If we must delete source SVM, we must first release all snapmirror relationship to be able to delete the vserver peering inside remove_vserver_source()
            Write-LogDebug "Get-NcSnapmirrorDestination -SourceVserver $myPrimaryVserver -DestinationVserver $mySecondaryVserver -Controller $myPrimaryController -ErrorVariable ErrorVar | Where-Object {$_.RelationshipGroupType -match none|flexgroup} | Invoke-NcSnapmirrorRelease"
            #$ret=Invoke-NcSnapmirrorRelease -Controller $myPrimaryController -Query @{DestinationVserver=$mySecondaryVserver;DestinationVolume="*";SourceVserver=$myPrimaryVserver;SourceVolume"*"} -ErrorVariable ErrorVar -Confirm:$False
            $ret=Get-NcSnapmirrorDestination -SourceVserver $myPrimaryVserver -DestinationVserver $mySecondaryVserver -Controller $myPrimaryController -ErrorVariable ErrorVar | Where-Object {$_.RelationshipGroupType -match "none|flexgroup"} | Invoke-NcSnapmirrorRelease -Controller $myPrimaryController -ErrorVariable ErrorVar -Confirm:$False
            if($? -ne $True){$Return=$False; Throw "ERROR : Failed to release destination relationship [${mySecondaryController}:${mySecondaryVserver}:* reason [$ErrorVar]"}
            if ( ( $ret = remove_vserver_source -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver) -eq $False ) {
                Write-LogError "ERROR: remove_vserver_dr: Unable to remove vserver [$myPrimaryVserver]" 
                clean_and_exit 1
            }
            $Global:SVMSourceDeleted=$True
        }else{
            Write-Log "[$myPrimaryVserver] User chose not to delete source SVM on Source Cluster [$PrimaryClusterName]"
            Write-Log "[$myPrimaryVserver] Will only be stopped on [$PrimaryClusterName]"
            Write-Log "In this case the SVM name on Destination Cluster [$SecondaryClusterName] is still [$mySecondaryVserver]"
            Write-Log "But CIFS identity is correctly migrated to [$PrimaryCIFSidentity] on [$SecondaryClusterName]"
            Write-Log "Final rename will be done when [-DeleteSource] step will be executed, once you are ready to completely delete [$myPrimaryVserver] on Source Cluster [$PrimaryClusterName]"
            $Global:SVMSourceDeleted=$False
        }
    }
} Catch {
    handle_error $_ $myPrimaryVserver
}
    Write-LogDebug "end Migrate_cifs_server"
	return $Return 
}

#############################################################################################
# return True if there is at least one CIFS LIF Up and Ready in a Vserver
# and return False if it's not the case
Function Is_One_LIF_Ready (
    [string] $myVserver,
    [NetApp.Ontapi.Filer.C.NcController] $myController    
) {
    $out=Get-NcNetInterface -VserverContext $myVserver -Query @{InterfaceName="*";OpStatus="up";DataProtocols="cifs"} -Attributes (Get-NcNetInterface -Template) -Controller $myController -ErrorVariable ErrorVar | select InterfaceName
    if( ($out | Measure-Object).Count -gt 0){
        return $True
    }else{
        return $False
    }
}

#############################################################################################
Function update_cifs_usergroup (
    [NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
	[NetApp.Ontapi.Filer.C.NcController] $mySecondaryController,
    [string] $myPrimaryVserver,
	[string] $mySecondaryVserver,
    [switch] $NoInteractive,
    [string]$workOn=$mySecondaryVserver,
    [string]$TemporarySecondaryCifsIp,
    [string]$SecondaryCifsLifMaster,
    [string]$SecondaryCifsLifCustomVlan,
    [bool]$Backup,
    [bool]$Restore) {
try{    
    #wait-debugger
    $Return = $True
    Write-Log "[$workOn] Update CIFS Local User & Local Group"
    Write-LogDebug "[$myPrimaryVserver]: start"
    if($Backup -eq $True){Write-LogDebug "run in Backup mode [$myPrimaryVserver]"}
    if($Restore -eq $True){Write-LogDebug "run in Restore mode [$myPrimaryVserver]"}
    <# if(-not (check_update_CIFS_server_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $mySecondaryVserver -Backup $RunBackup -Restore $RunRestore)){
        Write-LogDebug "update_cifs_usergroup: end"
        return $True
    } #>
    if($Global:NEED_CIFS_SERVER -eq $False){
        Write-LogDebug "Global:NEED_CIFS_SERVER = [False]"
        Write-LogDebug "end"
        return $Return  
    }
    #Write-LogDebug "[$workOn] Set Lif up to authenticate in AD user on DR"^
    # This could be done only if secondary LIF are presents. Which means works in non-preserve identity mode
    if( ($Backup -ne $True) -and ($Restore -ne $True) ){ 
        $SecondaryCifsLifCreated=$true
        if (-not (Is_One_LIF_Ready -myVserver $mySecondaryVserver -myController $mySecondaryController) ){
            if($TemporarySecondaryCifsIp -and $SecondaryCifsLifMaster){
                Write-LogWarn "[$workOn] Create tmp lif to join AD [$SecondaryCifsLifMaster][$TemporarySecondaryCifsIp]"
                $SecondaryCifsLifCreated=$false
                #if($Global:NonInteractive -or $ForClone -or $Global:PreserveIdentity -eq $True){
                Write-Log "[$workOn] getting master lif to clone"*
                Write-LogDebug "Get-NcNetInterface $SecondaryCifsLifMaster -VserverContext $myPrimaryVserver -Controller $myPrimaryController"
                $InterfaceMasterPrimary = Get-NcNetInterface $SecondaryCifsLifMaster -VserverContext $myPrimaryVserver -Controller $myPrimaryController  -ErrorVariable ErrorVar 
                Write-LogDebug "Get-NcNetInterface $SecondaryCifsLifMaster -VserverContext $mySecondaryVserver -Controller $mySecondaryController"
                $InterfaceMaster = Get-NcNetInterface $SecondaryCifsLifMaster -VserverContext $mySecondaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar
                Write-LogDebug "InterfaceMasterPrimary [$InterfaceMasterPrimary] InterfaceMaster [$InterfaceMaster]" 
                #}
                if($InterfaceMaster){
                    $TempInterfaceName=("tmp_lif_to_join_in_ad_" + $InterfaceMaster.InterfaceName)
                    $TempIpAddress=$TemporarySecondaryCifsIp
                    $InterfaceMasterNetMask=$InterfaceMasterPrimary.Netmask
                    <#if($Global:NonInteractive -and $ForClone){
                        $InterfaceMasterNetMask=$InterfaceMasterPrimary.Netmask
                    }else{
                        $InterfaceMasterNetMask=$InterfaceMaster.Netmask
                    } #>
                    $InterfaceMasterCurrentNode=$InterfaceMaster.CurrentNode
                    $InterfaceMasterCurrentPort=$InterfaceMaster.CurrentPort
                    if ($SecondaryCifsLifCustomVlan) {
                        Write-Log "[$workOn] a custom vlan has been provided for the temp cifs lif [$SecondaryCifsLifCustomVlan]"
                        $SecondaryCifsLifCustomVlanPort = Get-NcNetPortVlan -VlanId $SecondaryCifsLifCustomVlan -Node $InterfaceMasterCurrentNode -Controller $mySecondaryController
                        if ( $? -ne $True ) {
                            $Return = $False ; throw "ERROR: Get-NcNetPortVlan failed [$ErrorVar]" 
                        }
                        Write-Log ("[$workOn] Custom vlan found [{0}], using this port instead of the temp cifs lif" -f $SecondaryCifsLifCustomVlanPort.InterfaceName)
                        $InterfaceMasterCurrentPort = $SecondaryCifsLifCustomVlanPort.InterfaceName
                    }                    
                    $InterfaceMasterDataProtocols=$InterfaceMaster.DataProtocols
                    $InterfaceMasterDnsDomainName=$InterfaceMaster.DnsDomainName
                    $InterfaceMasterRole=$InterfaceMaster.Role
                    $InterfaceMasterFirewallPolicy=$InterfaceMaster.FirewallPolicy
                    $InterfaceMasterIsAutoRevert=$InterfaceMaster.IsAutoRevert
                    if($Global:PSTKCall -eq "Rest"){$InterfaceMasterServicePolicy=$InterfaceMaster.ServicePolicy}

                    $SecondaryInterface  = Get-NcNetInterface -InterfaceName $TempInterfaceName -VserverContext $mySecondaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar 
                    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
                    if ( $null -eq $SecondaryInterface ) 
                    {
                        if( -not ($Global:ForceCloneOriginal.IsPresent) ){
                            Write-LogDebug "Dns Domain is only set during Migrate, ActivateDR, ReActivate or CloneVserverDR with ForceCloneOriginal"
                            Write-LogDebug "Dns Domain will remain empty for temporary LIF"
                            $InterfaceMasterDnsDomainName=""    
                        }
                        Write-Log "[$workOn] Create the LIF [$TempInterfaceName] (cloned from $SecondaryCifsLifMaster)"
                        Write-Log "[$workOn] LIF [$TempInterfaceName] is the Temp Cifs LIF, it must be in Administrative up status"
                        if($Global:PSTKCall -eq "Rest"){
                            Write-LogDebug "New-NcNetInterface -Name $TempInterfaceName -Vserver $mySecondaryVserver -ServicePolicy $InterfaceMasterServicePolicy -Node $InterfaceMasterCurrentNode -Port $InterfaceMasterCurrentPort -DataProtocols $InterfaceMasterDataProtocols -Address $TempIpAddress -Netmask $InterfaceMasterNetMask -DnsDomain $InterfaceMasterDnsDomainName -AdministrativeStatus up -AutoRevert $InterfaceMasterIsAutoRevert -Controller $mySecondaryController"
                            $SecondaryInterface=New-NcNetInterface -Name $TempInterfaceName -Vserver $mySecondaryVserver  -ServicePolicy $InterfaceMasterServicePolicy -Node $InterfaceMasterCurrentNode -Port $InterfaceMasterCurrentPort -DataProtocols $InterfaceMasterDataProtocols -Address $TempIpAddress -Netmask $InterfaceMasterNetMask -DnsDomain $InterfaceMasterDnsDomainName -AdministrativeStatus up -AutoRevert $InterfaceMasterIsAutoRevert -Controller $mySecondaryController  -ErrorVariable ErrorVar    
                        }else{
                            Write-LogDebug "New-NcNetInterface -Name $TempInterfaceName -Vserver $mySecondaryVserver -Role $InterfaceMasterRole -Node $InterfaceMasterCurrentNode -Port $InterfaceMasterCurrentPort -DataProtocols $InterfaceMasterDataProtocols -FirewallPolicy $InterfaceMasterFirewallPolicy -Address $TempIpAddress -Netmask $InterfaceMasterNetMask -DnsDomain $InterfaceMasterDnsDomainName -AdministrativeStatus up -AutoRevert $InterfaceMasterIsAutoRevert -Controller $mySecondaryController"
                            $SecondaryInterface=New-NcNetInterface -Name $TempInterfaceName -Vserver $mySecondaryVserver  -Role $InterfaceMasterRole -Node $InterfaceMasterCurrentNode -Port $InterfaceMasterCurrentPort -DataProtocols $InterfaceMasterDataProtocols -FirewallPolicy $InterfaceMasterFirewallPolicy -Address $TempIpAddress -Netmask $InterfaceMasterNetMask -DnsDomain $InterfaceMasterDnsDomainName -AdministrativeStatus up -AutoRevert $InterfaceMasterIsAutoRevert -Controller $mySecondaryController  -ErrorVariable ErrorVar    
                        }
                        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: New-NcNetInterface failed [$ErrorVar]" ;  }
                        $TempCifsLif = Get-NcNetInterface ("tmp_lif_to_join_in_ad_" + $SecondaryCifsLifMaster) -VserverContext $mySecondaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar 
                        $SecondaryCifsLifCreated=$true
                        $Global:SecondaryCifsLifCreated=$true
                        
                    }
                }else{
                    Write-LogWarn "[$workOn] the lif [$SecondaryCifsLifMaster] does not exist in vserver [$mySecondaryVserver]"
                }
            }else{
                if($Global:Run_Mode -ne "Migrate"){
                    Write-LogDebug "No Temporary Secondary LIF information provided. Impossible to continue Update_cifs_usergroup"
                    Write-LogWarn "SKIPPING update CIFS local user & group without one LIF up & ready on secondary"
                    Write-LogWarn "You must create at least one temporay CIFS LIF on secondary for AD authentication"
                    Write-LogWarn "Or you must use argument TemporarySecondaryCifsIp and SecondaryCifsLifMaster to let UpdateDR creates this temporary CIFS LIF on secondary for you"
                    Write-LogDebug "[$myPrimaryVserver]: end"
                }
                return $True
            }
            # if (-not $Global:SecondaryCifsLifCreated){
            #     if (($ret=set_all_lif -mySecondaryVserver $mySecondaryVserver -myPrimaryVserver $myPrimaryVserver -mySecondaryController $mySecondaryController  -myPrimaryController $myPrimaryController -state up) -ne $True ) {
            #             Write-LogError "ERROR: Failed to set all lif up on [$mySecondaryVserver]"
            #             clean_and_exit 1
            #     }
            # }else{
            #     Write-LogWarn "[$workOn] Impossible to Update CIFS Local User & Group in Preserve Identity Mode. You need at least one LIF on secondary to authenticates user or group with AD"
            #     Write-LogDebug "update_cifs_usergroup[$myPrimaryVserver]: end"
            #     return $False
            # }

        }
        if (-not $SecondaryCifsLifCreated){
            Write-LogWarn "[$workOn] Impossible to Update CIFS Local User & Group. You need at least one LIF Up & Ready on secondary to authenticates user or group with AD"
            Write-LogDebug "[$myPrimaryVserver]: end"
            return $True        
        }
        Write-LogOnly "[OK] One LIF is Up & Ready on Secondary Vserver to allow AD authentication"
        Write-LogDebug "[$workOn] Get-NcCifsLocalUser -VserverContext $mySecondaryVserver -controller $mySecondaryController"
        
    }

    if($Restore -eq $False){
        Write-LogDebug "Get-NcCifsServer -VserverContext $myPrimaryVserver -controller $myPrimaryController"
        $PrimaryCifs=Get-NcCifsServer -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
    }else{
        if(Test-Path $($Global:JsonPath+"Get-NcCifsServer.json")){
            $PrimaryCifs=Get-Content $($Global:JsonPath+"Get-NcCifsServer.json") -Raw | ConvertFrom-Json
        }else{
            $Return=$False
            $filepath=$($Global:JsonPath+"Get-NcCifsServer.json")
            Throw "ERROR: failed to read $filepath"
        }
    }

    if($Backup -eq $False){
        $SecondaryUserList=Get-NcCifsLocalUser -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalUser failed [$ErrorVar]" }
    }
    $UserKept=@()
    $PrimaryCifsServer=$PrimaryCifs.CifsServer
    if($Backup -eq $False){
        Write-LogDebug "Get-NcCifsServer -VserverContext $mySecondaryVserver -controller $mySecondaryController"
        $SecondaryCifs=Get-NcCifsServer -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
        if($null -eq $SecondaryCifs){
            Write-LogWarn "You must first create your CIFS server on Secondary through ConfigureDR, before running other steps"
            Write-LogDebug "end"
            return $False
        }
        $SecondaryCifsServer=$SecondaryCifs.CifsServer
        # Pre Remove LocalUser only if we have a DefaultLocalUserCredential
        <# if(($null -ne $Global:DefaultLocalUserCredentials) -or ($Global:DefaultLocalUserCredentials.length -gt 0)){
            foreach($SecondaryUser in $SecondaryUserList | Skip-Null){
                $SecondaryUserName=$SecondaryUser.UserName
                try{
                    $ans='n'
                    if($NoInteractive -eq $False){
                        $ans=Read-HostOptions -question "[$mySecondaryVserver] Do you want to reset Password for User [$SecondaryUserName] on [$mySecondaryVserver]?" -options "y/n" -default "n"
                    }
                    if($ans -eq 'n'){
                        if($PrimaryCifsServer -ne $SecondaryCifsServer){$SecondaryUserName=$SecondaryUserName -replace $SecondaryCifsServer,$PrimaryCifsServer}
                        $UserKept+=$SecondaryUserName
                    }else{
                        Write-LogDebug "Remove-NcCifsLocalUser -UserName $SecondaryUserName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                        try{
                            $out=Remove-NcCifsLocalUser -UserName $SecondaryUserName -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar -Confirm:$False -EA stop
                            if ( $? -ne $True ) { Write-LogDebug "ERROR: Remove-NcCifsLocalUser $SecondaryUserName failed [$ErrorVar]" }
                        }catch{
                            $ErrorMessage = $_.Exception.Message
                            $ErrorDetails = $_.ErrorDetails
                            Write-LogDebug "[$mySecondaryVserver] failed to delete Cifs Local User [$ErrorMessage : $ErrorDetails]"
                        }
                    }
                }catch{
                    Write-LogDebug "Cannot remove local CIFS user [$SecondaryUserName] on [$mySecondaryVserver]"
                }
            }
        } #>
    }
    if($Restore -eq $False){
        Write-LogDebug "Get-NcCifsLocalUser -VserverContext $myPrimaryVserver -controller $myPrimaryController"
        $PrimaryUserList=Get-NcCifsLocalUser -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalUser failed [$ErrorVar]" }
    }else{
        if(Test-Path $($Global:JsonPath+"Get-NcCifsLocalUser.json")){
            $PrimaryUserList=Get-Content $($Global:JsonPath+"Get-NcCifsLocalUser.json") -Raw | ConvertFrom-Json
        }else{
            $Return=$False
            $filepath=$($Global:JsonPath+"Get-NcCifsLocalUser.json")
            Throw "ERROR: failed to read $filepath"
        }
    }
    if($Backup -eq $True){
        $PrimaryUserList | ConvertTo-Json -Depth 7 | Out-File -FilePath $($Global:JsonPath+"Get-NcCifsLocalUser.json") -Encoding ASCII -Width 65535
        if( $null -ne ($ret=get-item $($Global:JsonPath+"Get-NcCifsLocalUser.json") -ErrorAction SilentlyContinue) ){
            Write-LogDebug "$($Global:JsonPath+"Get-NcCifsLocalUser.json") saved successfully"
        }else{
            Write-LogWarn "Failed to saved $($Global:JsonPath+"Get-NcCifsLocalUser.json")"
            $Return=$True
        }
    }
    if($Backup -eq $False){
        # Update LocalUser password on remote only if we have a DefaultLocalUserCredential
        if(($null -ne $Global:DefaultLocalUserCredentials) -or ($Global:DefaultLocalUserCredentials.length -gt 0)){
            foreach($User in $PrimaryUserList | Where-Object {$_.UserName -notin $UserKept} | Skip-Null){
                $UserName=$User.UserName
                $UserDisabled=$User.Disabled
                $UserDescription=$User.Description
                $UserFullname=$User.FullName
                if($PrimaryCifsServer -ne $SecondaryCifsServer){$UserName=$UserName -replace $PrimaryCifsServer,$SecondaryCifsServer}
                if($UserFullname.length -eq 0 -or $UserFullname.count -eq 0){$UserFullname=""}
                Write-LogDebug "Work on [$UserName] [$UserDisabled] [$UserDescription] [$UserFullname] from Primary "
                if(($UserDescription -match "Built-in") -eq $True){
                    write-logdebug "Get-NcCifsLocalUser -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                    $SecondaryBuiltin=Get-NcCifsLocalUser -VserverContext $mySecondaryVserver -controller $mySecondaryController -ErrorVariable ErrorVar | Where-Object {$_.Description -match "Built-in"}
                    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalUser failed [$ErrorVar]" }
                    if($null -ne $SecondaryBuiltin){
                        $UserName=$SecondaryBuiltin.UserName
                    }
                    Write-LogDebug "Work on [$UserName] from Secondary "
                    do{
                        $modok=$True
                        $password=get_pwd_from_cli -workOn $workOn -for "CIFS Local User" -name $Username -asSecure
                        try{
                            Write-LogDebug "Set-NcCifsLocalUser -UserName $UserName -Password XXXXXXXXXX -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                            $out=Set-NcCifsLocalUser -UserName $UserName -Password $password -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                            if ( $? -ne $True ) { $Return = $False ;  ;throw "ERROR: Set-NcCifsLocalUser failed [$ErrorVar]" }
                            Write-LogDebug "Set-NcCifsLocalUser -UserName $UserName -FullName $UserFullname -Description $UserDescription -IsAccountDisable $UserDisabled -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                            $out=Set-NcCifsLocalUser -UserName $UserName -FullName $UserFullname -Description $UserDescription -IsAccountDisable $UserDisabled -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                            if ( $? -ne $True ) { $Return = $False ;  ;throw "ERROR: Set-NcCifsLocalUser failed [$ErrorVar]" }
                        }catch{
                            Write-LogWarn "[$workOn] Impossible to modify CIFS local user [$UserName] on [$mySecondaryVserver] reason [$_.Description]"
                            if(-not $NoInteractive -and -not $Global:NonInteractive){
                                $modok=$False
                            }
                        }
                    }while($modok -eq $False)
                }else{
                    do{
                        $addok=$true
                        $password=get_pwd_from_cli -workOn $workOn -for "CIFS Local User" -name $Username -asSecure

                        if($UserDisabled -eq $True){
                            try{
                                Write-LogDebug "Check if user [$UserName] already exist on [$mySecondaryVserver]"
                                Write-LogDebug "Get-NcCifsLocalUser -Vserver $mySecondaryVserver -UserName $UserName -controller $mySecondaryController"
                                $IsUserExist=Get-NcCifsLocalUser -Vserver $mySecondaryVserver -UserName $UserName -controller $mySecondaryController
                                if($IsUserExist){
                                    Write-LogDebug "New-NcCifsLocalUser -UserName $UserName -Password XXXXXXXXXX -FullName $UserFullname -Description $UserDescription -Disable -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                                    $out=New-NcCifsLocalUser -UserName $UserName -Password $password -FullName $UserFullname -Description $UserDescription -Disable -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                                    if ( $? -ne $True ) { $Return = $False ;  ;throw "ERROR: New-NcCifsLocalUser failed [$ErrorVar]" }
                                }
                            }catch{
                                $ErrorVar = $_.Exception.Message
                                Write-LogWarn "[$workOn] Impossible to create new CIFS local user [$UserName] on [$mySecondaryVserver] reason [$ErrorVar]"
                                $addok=$false
                            }
                        }else{
                            try{
                                Write-LogDebug "Check if user [$UserName] already exist on [$mySecondaryVserver]"
                                Write-LogDebug "Get-NcCifsLocalUser -Vserver $mySecondaryVserver -UserName $UserName -controller $mySecondaryController"
                                $IsUserExist=Get-NcCifsLocalUser -Vserver $mySecondaryVserver -UserName $UserName -controller $mySecondaryController
                                if(-not $IsUserExist){
                                    Write-LogDebug "New-NcCifsLocalUser -UserName $UserName -Password XXXXXXXXXX -FullName $UserFullname -Description $UserDescription -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                                    $out=New-NcCifsLocalUser -UserName $UserName -Password $password -FullName $UserFullname -Description $UserDescription -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                                    if ( $? -ne $True ) { $Return = $False ;  ;throw "ERROR: New-NcCifsLocalUser failed [$ErrorVar]" }
                                }
                            }catch{
                                $ErrorVar = $_.Exception.Message
                                Write-LogWarn "[$workOn] Impossible to create new CIFS local user [$UserName] on [$mySecondaryVserver] reason [$ErrorVar]"
                                $addok=$false
                            }
                        }
                    }while($addok -eq $false)
                }
            }
        }
    }
    # Pre Empty or remove secondary LocalGroup
    <# if($Backup -eq $False){
        Write-LogDebug "Get-NcCifsLocalGroup -VserverContext $mySecondaryVserver -controller $mySecondaryController"
        $SecondaryGroupList=Get-NcCifsLocalGroup -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroup failed [$ErrorVar]" }
        foreach($SecondaryGroup in $SecondaryGroupList | Skip-Null){
            $SecondaryGroupName=$SecondaryGroup.GroupName
            $notremoved=$False
            try{
                Write-LogDebug "Remove-NcCifsLocalGroup -GroupName $SecondaryGroupName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                $out=Remove-NcCifsLocalGroup -GroupName $SecondaryGroupName -VserverContext $mySecondaryVserver -Controller $mySecondaryController -ErrorAction SilentlyContinue -ErrorVariable ErrorVar -Confirm:$False
                if ( $? -ne $True ) { 
                    Write-LogDebug "ERROR: Remove-NcCifsLocalGroup failed [$ErrorVar]" 
                    if(($ErrorVar | Out-String) -match "Cannot delete any BUILTIN group"){$notremoved=$True}
                }
            }catch{
                $ErrorVar = $_.Exception.Message
                Write-LogDebug "Group [$SecondaryGroupName] not remove from [$mySecondaryVserver], reason [$ErrorVar]"
                $notremoved=$True
            }
            if($notremoved -eq $True){
                Write-LogDebug "Get-NcCifsLocalGroupMember -Name $SecondaryGroupName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                $SecondaryMemberList=Get-NcCifsLocalGroupMember -Name $SecondaryGroupName -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroupMermber failed [$ErrorVar]" }
                foreach($SecondaryMember in $SecondaryMemberList | Skip-Null){
                    $SecondaryMemberName=$SecondaryMember.Member
                    try{
                        Write-LogDebug "Remove-NcCifsLocalGroupMember -Name $SecondaryGroupName -Member $SecondaryMemberName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                        $out=Remove-NcCifsLocalGroupMember -Name $SecondaryGroupName -Member $SecondaryMemberName -VserverContext $mySecondaryVserver -controller $mySecondaryController -ErrorAction SilentlyContinue -ErrorVariable ErrorVar -Confirm:$False
                        if ( $? -ne $True ) { Write-LogDebug "ERROR: Remove-NcCifsLocalGroupMember failed [$ErrorVar]" }
                    }catch{
                        $ErrorVar = $_.Exception.Message
                        Write-LogDebug "unable to remove Member [$SecondaryMemberName] from [$SecondaryGroupName] on [$mySecondaryVserver] reason [$ErrorVar]"
                    }
                }        
            }
        }
    } #>
    if($Restore -eq $False){
        Write-LogDebug "Get-NcCifsLocalGroup -VserverContext $myPrimaryVserver -controller $myPrimaryController"
        $PrimaryGroupList=Get-NcCifsLocalGroup -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroup failed [$ErrorVar]" }
    }else{
        if(Test-Path $($Global:JsonPath+"Get-NcCifsLocalGroup.json")){
            $PrimaryGroupList=Get-Content $($Global:JsonPath+"Get-NcCifsLocalGroup.json") -Raw | ConvertFrom-Json
        }else{
            $Return=$False
            $filepath=$($Global:JsonPath+"Get-NcCifsLocalGroup.json")
            Throw "ERROR: failed to read $filepath"
        }
    }
    # Store Primary GroupList into JSON files only in backup mode
    if($Backup -eq $True){
        $PrimaryGroupList | ConvertTo-Json -Depth 7 | Out-File -FilePath $($Global:JsonPath+"Get-NcCifsLocalGroup.json") -Encoding ASCII -Width 65535
        if( $null -ne ($ret=get-item $($Global:JsonPath+"Get-NcCifsLocalGroup.json") -ErrorAction SilentlyContinue) ){
            Write-LogDebug "$($Global:JsonPath+"Get-NcCifsLocalGroup.json") saved successfully"
        }else{
            Write-LogWarn "Failed to saved $($Global:JsonPath+"Get-NcCifsLocalGroup.json")"
            $Return=$True
        }
        foreach($PrimaryGroup in $PrimaryGroupList | Skip-Null){
            $PrimaryGroupName=$PrimaryGroup.GroupName
            Write-LogDebug "Get-NcCifsLocalGroupMember -Name $PrimaryGroupName -VserverContext $myPrimaryVserver -controller $myPrimaryController"
            $PrimaryMemberList=Get-NcCifsLocalGroupMember -Name $PrimaryGroupName -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroupMermber failed [$ErrorVar]" }
            $PrimaryGroupName_string=$PrimaryGroupName -replace "\\","_"
            $PrimaryMemberList | ConvertTo-Json -Depth 7 | Out-File -FilePath $($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json") -Encoding ASCII -Width 65535
            if( $null -ne ($ret=get-item $($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json") -ErrorAction SilentlyContinue) ){
                Write-LogDebug "$($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json") saved successfully"
            }else{
                Write-LogWarn "Failed to saved $($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json")"
                $Return=$True
            }
        }
    }
    # Update Group and Group Member
    if($Backup -eq $False){
        foreach($PrimaryGroup in $PrimaryGroupList | Skip-Null){
            $PrimaryGroupName=$PrimaryGroup.GroupName
            $PrimaryGroupDescription=$PrimaryGroup.Description
            # Check CIFS LocalGroup on secondary
            if($PrimaryGroupName -notmatch "^BUILTIN\\"){
                $PrimaryGroupNameWithoutDomain = ($PrimaryGroupName -replace "[^\\]*\\","")
                $SecondaryGroupName = "$SecondaryCifsServer\$PrimaryGroupNameWithoutDomain"
                Write-LogDebug "Get-NcCifsLocalGroup -Name $SecondaryGroupName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                $SecondaryGroup=Get-NcCifsLocalGroup -Name $SecondaryGroupName -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroup failed [$ErrorVar]" }
                if($null -eq $SecondaryGroup){
                    # if localgroup is missing on secondary, create it
                    try{
                        Write-Log "[$mySecondaryVserver] Add Local Group [$PrimaryGroupNameWithoutDomain]"
                        Write-LogDebug "New-NcCifsLocalGroup -Name $PrimaryGroupNameWithoutDomain -Description $PrimaryGroupDescription -VserverContext $mySecondaryVserver -controller $mySecondaryController" 
                        $out=New-NcCifsLocalGroup -Name $PrimaryGroupNameWithoutDomain -Description $PrimaryGroupDescription -VserverContext $mySecondaryVserver -controller $mySecondaryController  -ErrorVariable ErrorVar
                        if ( $? -ne $True ) { Write-LogDebug "ERROR: New-NcCifsLocalGroup failed [$ErrorVar]" }
                    }catch{
                        Write-LogDebug "Cannot create Group [$PrimaryGroupName] on [$mySecondaryVserver], reason [$ErrorVar]"
                    }

                }
            }else{
                $SecondaryGroupName = $PrimaryGroupName
                $PrimaryGroupNameWithoutDomain = $PrimaryGroupName
            }
            # Retreive LocalGroup member on Primary
            if($Restore -eq $False){
                Write-LogDebug "Get-NcCifsLocalGroupMember -Name $PrimaryGroupName -VserverContext $myPrimaryVserver -controller $myPrimaryController"
                $PrimaryMemberList=Get-NcCifsLocalGroupMember -Name $PrimaryGroupName -VserverContext $myPrimaryVserver -controller $myPrimaryController  -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsLocalGroupMember failed [$ErrorVar]" }
            }else{
                $PrimaryGroupName_string=$PrimaryGroupName -replace "\\","_"
                if(Test-Path $($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json")){
                    $PrimaryMemberList=Get-Content $($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json") -Raw | ConvertFrom-Json
                }else{
                    $Return=$False
                    $filepath=$($Global:JsonPath+"Get-NcCifsLocalGroupMember-"+$PrimaryGroupName_string+".json")
                    Throw "ERROR: failed to read $filepath"
                }    
            }
            # Add LocalGroup member
            foreach($PrimaryMember in $PrimaryMemberList | Skip-Null){
                $PrimaryMemberName=$PrimaryMember.Member
                $PrimaryMemberVserverName=$PrimaryMember.Vserver
                # if it's a local machine user <VSERVER NAME>\<USER> we need to replace it with remote DR machine name <VSERVER DR NAME>\<USER>
                # if it's a local machine user <CIFS NAME>\<USER> we need to replace it with remote DR machine name <CIFS DR NAME>\<USER>
                #if(($PrimaryMemberName -notmatch "^BUILTIN\\") -and ($PrimaryMemberName -notmatch $("^"+$PrimaryCifs.DomainWorkgroup+"\\"))){
                if(($PrimaryMemberName -match $("^"+$PrimaryCifsServer+"\\"))){
                    $PrimaryMemberNameWithoutDomain = ($PrimaryMemberName -replace "[^\\]*\\","")
                    $SecondaryMemberName = "$SecondaryCifsServer\$PrimaryMemberNameWithoutDomain"
                }else{
                    $PrimaryMemberNameWithoutDomain = $PrimaryMemberName
                    $SecondaryMemberName = $PrimaryMemberName
                }
                # Add new group member only if missing on secondary
                if($null -eq (Get-NcCifsLocalGroupMember -Name $SecondaryGroupName -Member $SecondaryMemberName -VserverContext $mySecondaryVserver -controller $mySecondaryController))
                {
                    try{
                        Write-Log "[$mySecondaryVserver] Add Local Group Member [$SecondaryMemberName] in Group [$SecondaryGroupName]"
                        Write-LogDebug "Add-NcCifsLocalGroupMember -Name $SecondaryGroupName -Member $SecondaryMemberName -VserverContext $mySecondaryVserver -controller $mySecondaryController"
                        $out=Add-NcCifsLocalGroupMember -Name $SecondaryGroupName -Member $SecondaryMemberName -VserverContext $mySecondaryVserver -controller $mySecondaryController -ErrorAction SilentlyContinue -ErrorVariable ErrorVar
                        if ( $? -ne $True ) { Write-LogDebug "ERROR: Add-NcCifsLocalGroupMember failed [$ErrorVar]" }
                    }catch{

                        Write-LogDebug "Member [$PrimaryMemberName] already exists in [$PrimaryGroupName] on [$mySecondaryVserver]"

                    }
                }else{
                    Write-LogDebug "Group Member [$SecondaryMemberName] already exist in Group [$SecondaryGroupName]"
                }
            }   
    
        }
    }
    <# if (($ret=set_all_lif -mySecondaryVserver $mySecondaryVserver -myPrimaryVserver $myPrimaryVserver -mySecondaryController $mySecondaryController  -myPrimaryController $myPrimaryController -state down) -ne $True ) {
        Write-LogError "ERROR: Failed to set all lif down on [$mySecondaryVserver]"
        clean_and_exit 1
    } #>
    Write-LogDebug "[$myPrimaryVserver]: end"
    return $True
} Catch {
    handle_error $_ $myPrimaryVserver
}
    Write-LogDebug "end"
	return $Return 
}

#############################################################################################
Function update_vserver_dr (
	[NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
	[NetApp.Ontapi.Filer.C.NcController] $mySecondaryController,
	[string] $myPrimaryVserver,
	[string] $mySecondaryVserver,
	[string] $myDataAggr,
    [bool] $DDR,
    [string]$aggrMatchRegEx,
    [string]$nodeMatchRegEx,
    [switch]$FromReactivate,
    [switch]$InReverse,
    [string]$TemporarySecondaryCifsIp,
    [string]$SecondaryCifsLifMaster,
    [string]$SecondaryCifsLifCustomVlan,
    [bool] $NoSnapmirrorUpdate=$false,
    [bool] $NoSnapmirrorWait=$false) {
	$Return = $True
	Write-LogDebug "start"
	if ( ( check_update_vserver -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { Write-LogError "ERROR: Failed check update vserver" ; return $False }
 
	Write-LogDebug "Update policy"
	<# if ( ( create_update_policy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver )  -ne $True ) {
		Write-LogError "ERROR: create_update_policy_dr failed" 
		$Return = $False
	} #>												  
																																																					
	if ( $myDataAggr -or $aggrMatchRegEx ) {
		Write-LogDebug "Create required new volumes $mySecondaryController Vserver $Vserver"

		if ( ( create_volume_voldr -myDataAggr $myDataAggr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -aggrMatchRegEx $aggrMatchRegEx ) -ne $True ) { Write-LogError "ERROR: Failed to create all volumes" ; return $False }

		Write-LogDebug "Create required new snapmirror relations $mySecondaryController Vserver $Vserver"
		if ( ( create_snapmirror_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -DDR $DDR ) -ne $True ) { Write-LogError "ERROR: Failed to create all snapmirror relations " ; return $False }
        if(-not $NoSnapMirrorWait){
            Write-LogDebug "Wait new Snapmirror transfer terminate $mySecondaryController Vserver $Vserver"
            if ( ( $ret=wait_snapmirror_dr -NoInteractive -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { Write-LogError "ERROR: Failed snapmirror relations bad status " ; return $False }
        }else{
            Write-LogDebug "Skipping snapmirror wait"
        }
	}
    
    if(-not $NoSnapMirrorUpdate){
        Write-LogDebug "Update Snapmirror Controller $mySecondaryController Vserver $Vserver"
        if ( ( update_snapmirror_vserver -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
            Write-LogError "ERROR: update_snapmirror_vserver failed" 
            return  $False
        }
    }else{
            Write-LogDebug "Skipping snapmirror update"
    }
	Write-LogDebug "Update igroup"
	if ( ( create_update_igroupdr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
		Write-LogError "ERROR: create_update_igroupdr failed" 
		$Return = $False
	}
    Write-LogDebug "Update efficiency policy"
	if ( ( create_update_efficiency_policy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver )  -ne $True ) {
		Write-LogError "ERROR: create_update_efficiency_policy_dr failed" 
		$Return = $False
	}
    Write-LogDebug "Update firewall policy"
    if ( ( create_update_firewallpolicy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver) -ne $True ) { 
        Write-LogError "ERROR: Failed to create all Firewall policy" 
        $Return = $False 
    }
    <# Write-LogDebug "Update lif dr"
	if ( ( create_lif_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -nodeMatchRegEx $nodeMatchRegEx) -ne $True ) {
        Write-LogError "ERROR: create_lif_dr failed" 
		$Return = $True
    } #>

    #if((-not $Global:NonInteractive) -or ($null -ne $Global:DefaultLocalUserCredentials)){
    if ($null -ne $Global:DefaultLocalUserCredentials){
        Write-LogDebug "Update local user dr"
        if ( ( create_update_localuser_dr  -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
            Write-LogError "ERROR: Failed to create all Local Users"
            $Return = $True 
        }
       
    }else{
        Write-LogWarn "SKIPPING local user create/update without default credentials"
    }
    # execute update_cifs_usergroup for each UpdateDR
    # or if you provide DefaultLocalUserCredentials
    #if((-not $Global:NonInteractive) -or ($null -ne $Global:DefaultLocalUserCredentials)){
    if($Global:NFSonly -eq $False){
        if (($ret=set_all_lif -mySecondaryVserver $mySecondaryVserver -myPrimaryVserver $myPrimaryVserver -mySecondaryController $mySecondaryController  -myPrimaryController $myPrimaryController -state up) -ne $True ) {
            Write-LogWarn "WARNING: Failed to set all lif up on [$mySecondaryVserver]"
            $Return=$False
        }
        Write-LogDebug "Update local cifs user dr"
        if ( ( update_cifs_usergroup  -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -TemporarySecondaryCifsIp $TemporarySecondaryCifsIp -SecondaryCifsLifMaster $SecondaryCifsLifMaster -SecondaryCifsLifCustomVlan $SecondaryCifsLifCustomVlan) -ne $True ) { 
            Write-LogError "ERROR: Failed to create all Local Cifs Users & Group"
            $Return = $False 
        }
        if($Global:Run_Mode -ne "ReActivate"){
            if (($ret=set_all_lif -mySecondaryVserver $mySecondaryVserver -myPrimaryVserver $myPrimaryVserver -mySecondaryController $mySecondaryController  -myPrimaryController $myPrimaryController -state down) -ne $True ) {
                Write-LogDebug "retrun after set_all_lif [$ret]"
                Write-LogWarn "WARNING: Failed to set all lif down on [$mySecondaryVserver]"
                $Return=$False
            } 
        }
    }
    <# }else{
        Write-LogWarn "SKIPPING local  user create/update in NonInteractive Mode or without default credentials or during UpdateDR"
         Write-LogWarn "Use ConfigureDR if you need to update CIFS Local User and Group on Secondary"
    } #>

    Write-LogDebug "Update local Unix User & Group"
    if ( ( create_update_localunixgroupanduser_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
        Write-LogError "ERROR: Failed to create all Local Unix User and Group"
        $Return = $False 
    }
    if ( ( create_update_usermapping_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
        Write-LogError "ERROR: Failed to create User Mapping"
        $Return = $False
    }
	if(-not $Global:skipVscanFpolicy){						  
		Write-LogDebug "Update Vscan dr"
		if ( ( create_update_vscan_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
			Write-LogError "ERROR: create_update_vscan_dr failed" 
			$Return = $False 
		}
		Write-LogDebug "Update Fpolicy dr"
		if ( ( create_update_fpolicy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
			Write-LogError "ERROR: create_update_fpolicy_dr failed" 
			$Return = $False 
		}
	}
	Write-LogDebug "Check Destination Volumes"
	if ( ( check_update_voldr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -InReverse ($InReverse.IsPresent) ) -ne $True ) {
		Write-LogError "ERROR: check_update_voldr failed" 
		$Return = $False
	}
	Write-LogDebug "mount all volume"
	if ( ( mount_voldr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
		Write-LogError "ERROR: mount_voldr Failed failed" 
		$Return = $False
	}
	if ( ( create_update_DNS_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
		Write-LogError "ERROR: create_update_DNS_dr failed" 
		$Return = $False 
	}
	if ( ( create_update_NIS_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
		Write-LogError "ERROR: create_update_NIS_dr failed" 
		$Return = $False 
	}
	if ( ( create_update_NFS_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -FromReactivate ($FromReactivate.IsPresent) ) -ne $True ) {
		Write-LogError "ERROR: create_update_NFS_dr failed" 
		$Return = $False 
	}
	if ( ( create_update_ISCSI_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
		Write-LogError "ERROR: create_update_ISCSI_dr failed" 
		$Return = $False 
    }
    if($Global:NFSonly -eq $False){
        if ( ( create_update_CIFS_shares_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -workOn $mySecondaryVserver -FromReactivate:($FromReactivate.IsPresent) ) -ne $True ) {
            Write-LogError "ERROR: create_update_CIFS_share failed" 
            $Return = $False 
        }
    }
	Write-LogDebug "Update cifs symlink"
	if ( ( create_update_cifs_symlink_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {
		Write-LogError "ERROR: create_update_cifs_symlink_dr failed" 
		$Return = $False
	}
	if ( ( map_lundr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
		Write-LogError "ERROR: Failed to map all LUNs failed" 
		$Return = $False 
	}
	if ( ( set_serial_lundr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
		Write-Log "ERROR: Failed to change LUN serial Numbers"  
		$Return = $False 
	}
    if ( ( create_update_qospolicy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) { 
        Write-LogError "ERROR: create_update_qospolicy_dr"
        $Return = $False 
    }
    if ( ( create_update_role_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver) -ne $True ) {
		Write-LogError "ERROR: create_update_role_dr"
	}
    if ( ( $ret=update_qtree_export_policy_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver ) -ne $True ) {Write-Log "ERROR Failed to modify all Qtree Export Policy" ; $Return = $False}
    
    <# if($Global:SecondaryCifsLifCreated){
        Write-Log "[$mySecondaryVserver] Removing Temporary LIF"
        Write-LogDebug "Get-NcNetInterface -Vserver $mySecondaryVserver -Controller $mySecondaryController | Where-Object {$_.InterfaceName -match `"^tmp_lif_to_join_in_ad_`"}"
        $TempCifsLif=Get-NcNetInterface -Vserver $mySecondaryVserver -Controller $mySecondaryController | Where-Object {$_.InterfaceName -match "^tmp_lif_to_join_in_ad_"}
        Write-logDebug "Set-NcNetInterface $($TempCifsLif.InterfaceName) -Vserver $mySecondaryVserver -AdministrativeStatus down -Controller $mySecondaryController -ErrorVariable ErrorVar"
        $out = Set-NcNetInterface -Name $TempCifsLif.InterfaceName -Vserver $mySecondaryVserver -AdministrativeStatus down -Controller $mySecondaryController -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcNetInterface failed [$ErrorVar]" ; }
        Write-LogDebug "Remove-NcNetInterface $($TempCifsLif.InterfaceName) -Vserver $mySecondaryVserver -Confirm:$false -Controller $mySecondaryController -ErrorVariable ErrorVar"
        $out = Remove-NcNetInterface -Name $TempCifsLif.InterfaceName -Vserver $mySecondaryVserver -Confirm:$false -Controller $mySecondaryController -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Remove-NcNetInterface failed [$ErrorVar]" ; }
    } #>
    if($Global:NFSonly -eq $False){
        Write-LogDebug "Get-NcNetInterface -Vserver $mySecondaryVserver -Controller $mySecondaryController | Where-Object {$_.InterfaceName -match `"^tmp_lif_to_join_in_ad_`"}"
        $TempCifsLif=Get-NcNetInterface -Vserver $mySecondaryVserver -Controller $mySecondaryController | Where-Object {$_.InterfaceName -match "^tmp_lif_to_join_in_ad_"}
        if($null -ne $TempCifsLif){
            Write-Log "[$mySecondaryVserver] Removing Temporary LIF"
            Write-logDebug "Set-NcNetInterface $($TempCifsLif.InterfaceName) -Vserver $mySecondaryVserver -AdministrativeStatus down -Controller $mySecondaryController -ErrorVariable ErrorVar"
            $out = Set-NcNetInterface -Name $TempCifsLif.InterfaceName -Vserver $mySecondaryVserver -AdministrativeStatus down -Controller $mySecondaryController -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcNetInterface failed [$ErrorVar]" ; }
            Write-LogDebug "Remove-NcNetInterface $($TempCifsLif.InterfaceName) -Vserver $mySecondaryVserver -Confirm:$false -Controller $mySecondaryController -ErrorVariable ErrorVar"
            $out = Remove-NcNetInterface -Name $TempCifsLif.InterfaceName -Vserver $mySecondaryVserver -Confirm:$false -Controller $mySecondaryController -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Remove-NcNetInterface failed [$ErrorVar]" ; }
        }
    }
    Write-LogDebug "end"
	return $Return
}

#############################################################################################
Function disable_network_protocol_vserver_dr (
	[NetApp.Ontapi.Filer.C.NcController] $myController,
    [string] $myVserver,
    [switch] $ForceDisable) {
Try {
	$Return = $True	
	Write-LogDebug "start"
    if(-not $ForceDisable){
        $ANS=Read-HostOptions -question "Ready to disable all Network Services in SVM [$myVserver] from  cluster [$myController] ?" -options "y/n" -default "y"
        if ( $ANS -ne 'y' ) {
            return $Return
        }
    }
    Write-Log "[$myVserver] Disable all services and LIF"
	# Verify if ISCSI service is Running if yes the stop it
	$IscsiService = Get-NcIscsiService -VserverContext  $myVserver -Controller $myController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcIscsiService failed [$ErrorVar]" }
	if ( $null -eq $IscsiService ) {
		Write-Log "[$myVserver] No ISCSI services in vserver"
	} else {
		if ( $IscsiService.IsAvailable -eq $True ) {
            Write-Log "[$myVserver] Stop iSCSI"
			Write-LogDebug "Disable-NcIscsi -VserverContext $myVserver -Controller $myController -Confirm:$False"
			$out=Disable-NcIscsi -VserverContext $myVserver -Controller $myController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to disable iSCSI on Vserver [$myVserver]" 
				$Return = $False
			}
		}
	}
	# Verify if NFS service is Running if yes the stop it
	$NfsService = Get-NcNfsService -VserverContext  $myVserver -Controller $myController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNfsService failed [$ErrorVar]" }
	if ( $null -eq $NfsService ) {
		Write-Log "[$myVserver] No NFS services in vserver"
	} else {
		if ( ( $NfsService.IsNfsv3 -or $NfsService.IsNfsv4 -or $NfsService.GeneralAccess ) -eq $True ) {
            Write-Log "[$myVserver] Stop NFS"
			Write-LogDebug "Disable-NcNfs -VserverContext $myVserver -Controller $myController -Confirm:$False"
			$out=Disable-NcNfs -VserverContext $myVserver -Controller $myController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to disable NFS on Vserver [$myVserver]" 
				$Return = $False
			}
		}
	}
	# Verify if CIFS Service is Running if yes stop it
	$CifService = Get-NcCifsServer  -VserverContext  $myVserver -Controller $myController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
	if ( $null -eq $CifService ) {
		Write-Log "[$myVserver] No CIFS services in vserver"
	} else {
		if ( $CifService.AdministrativeStatus -eq 'up' ) {
            Write-Log "[$myVserver] Stop CIFS"
			Write-LogDebug "stop-NcCifsServer -VserverContext $myVserver -Controller $myController -Confirm:$False"
			$out=Stop-NcCifsServer -VserverContext $myVserver -Controller $myController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to disable CIFS on Vserver [$myVserver]" 
				$Return = $False
			}
		}
	}
	# Stop All NetWork Interface
	$InterfaceList = Get-NcNetInterface -Role DATA -VserverContext $myVserver -Controller $myController  -ErrorVariable ErrorVar 
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
	foreach ( $Interface in ( $InterfaceList | Skip-Null ) ) {
        $InterfaceName=$Interface.InterfaceName
        $PrimaryFirewallPolicy=$Interface.FirewallPolicy
        $PrimaryDataProtocols=$Interface.DataProtocols
        $PrimaryAddress=$Interface.Address
        # do not disable mgmt LIF unless it is created with APIPA address
        #Write-Log "Treatment of LIF [$InterfaceName] [$PrimaryFirewallPolicy] [$PrimaryDataProtocols] [$PrimaryAddress]" 
        if ( ( $PrimaryFirewallPolicy -eq "mgmt" ) -and ( $PrimaryDataProtocols -eq "none" ) -and ( $PrimaryAddress -notmatch "169.254")) {
            Write-LogDebug "Interface [$InterfaceName] is a management Interface must not be down"
        } else {
            Write-Log "[$myVserver] Stop LIF [$InterfaceName]"
            Write-LogDebug "Set-NcNetInterface  -Name $InterfaceName -AdministrativeStatus down -Vserver $myVserver -Controller $myController"
            $out = Set-NcNetInterface -Name $InterfaceName -AdministrativeStatus down -Vserver $myVserver -Controller $myController  -ErrorVariable ErrorVar
        }
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcNetInterface failed [$ErrorVar]" }
        if ( $? -ne $True ) { 
            Write-LogError "ERROR: Failed to start stop interface [$InterfaceName] " 
            $Return = $False 
        }
	}
    Write-LogDebug "end"
	return $Return 
}
Catch {
    handle_error $_ $myVserver
	return $Return
}
}

#############################################################################################
Function enable_network_protocol_vserver_dr (
	[NetApp.Ontapi.Filer.C.NcController] $myNcController,
	[string] $myVserver ) {
Try {
	$Return = $True
    Write-logDebug "start"
    if( ( (Get-NcVserver -Vserver $myVserver -controller $myNcController).State) -ne "running"){
        Write-Log "[$myVserver] Start Vserver"
        Write-LogDebug "Start-NcVserver -Name $myVserver -Controller $myNcController"
        $ret=Start-NcVserver -Name $myVserver -Controller $myNcController -ErrorVariable ErrorVar
        if ($? -ne $True){$Return=$False;Throw "FAILED to start Vserver [$myVserver] reason [$ErrorVar]"}
    }
	# Start all Network Interfaces
	$InterfaceList = Get-NcNetInterface -Role DATA -VserverContext $myVserver -Controller $myNcController  -ErrorVariable ErrorVar 
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
	foreach ( $Interface in ( $InterfaceList | Skip-Null ) ) {
            $InterfaceName=$Interface.InterfaceName
            Write-Log "[$myVserver] Start LIF [$InterfaceName]"
			Write-LogDebug "Set-NcNetInterface  -Name $InterfaceName -AdministrativeStatus up -Vserver $myVserver -Controller $myNcController"
			$out = Set-NcNetInterface -Name $InterfaceName -AdministrativeStatus up -Vserver $myVserver -Controller $myNcController  -ErrorVariable ErrorVar
			if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcNetInterface failed [$ErrorVar]" }	
	}
	
	# Verify if ISCSI service is Running 
	$IscsiService = Get-NcIscsiService -VserverContext  $myVserver -Controller $myNcController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcIscsiService failed [$ErrorVar]" }
	if ( $IscsiService -eq $null ) {
		Write-Log "[$myVserver] No ISCSI services in vserver"
	} else {
		if ( $IscsiService.IsAvailable -ne $True ) {
            Write-Log "[$myVserver] Start iSCSI"
			Write-LogDebug "Enable-NcIscsi -VserverContext $myVserver -Controller $myNcController"
			$out=Enable-NcIscsi -VserverContext $myVserver -Controller $myNcController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to enable iSCSI on Vserver [$myVserver]" 
				$Return = $False
			}
		}
		
	}
	
	# Verify if NFS service is Running 
	$NfsService = Get-NcNfsService -VserverContext  $myVserver -Controller $myNcController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNfsService failed [$ErrorVar]" }
	if ( $NfsService -eq $null ) {
		Write-Log "[$myVserver] No NFS services in vserver"
	} else {
		if ( $NfsService.GeneralAccess -ne $True ) {
            Write-Log "[$myVserver] Start NFS"
			Write-LogDebug "Enable-NcNfs -VserverContext $myVserver -Controller $myNcController"
			$out=Enable-NcNfs -VserverContext $myVserver -Controller $myNcController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to enable NFS on Vserver [$myVserver]" 
				$Return = $False
			}
		}
		
	}
	
	# Verify if CIFS Service is Running 
	$CifService = Get-NcCifsServer  -VserverContext  $myVserver -Controller $myNcController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCifsServer failed [$ErrorVar]" }
	if ( $CifService -eq $null ) {
		Write-Log "[$myVserver] No CIFS services in vserver"
	} else {
		if ( $CifService.AdministrativeStatus -ne 'up' ) {
            Write-Log "[$myVserver] Start CIFS"
			Write-LogDebug "start-NcCifsServer -VserverContext $myVserver -Controller $myNcController"
			$out=start-NcCifsServer -VserverContext $myVserver -Controller $myNcController  -ErrorVariable ErrorVar -Confirm:$False
			if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to enable CIFS on Vserver [$myVserver]" 
				$Return = $False
			}
		}
	}
    Write-logDebug "end"
	return $Return 
}
Catch {
    handle_error $_ $myVserver
	return $Return
}
}

#############################################################################################
Function restart_vserver_dr (
    [NetApp.Ontapi.Filer.C.NcController] $myController,
	[string] $myVserver ) {

Try { 
	$Return = $True
    Write-LogDebug "start"
    $Vserver=Get-NcVserver -Name $myVserver -Controller $myController -ErrorVariable ErrorVar
    if ( $? -ne $True ) {
        Write-LogError "ERROR: Get-NcVserver Failed for [$myVserver] reason [$ErrorVar]" 
        $Return = $False
    }
    $State=$Vserver.State
    if($State -ne "running"){
        if($Global:ForceRestart){
            Write-LogDebug "ForceRestart is Present"
            $ret=Start-NcVserver -Name $myVserver -Controller $myController -ErrorVariable ErrorVar -Confirm:$False
            if ( $? -ne $True ) {
				Write-LogError "ERROR: Failed to restart Vserver [$myVserver]" 
				$Return = $False
			}
        }else{
            Write-Log "[$myVserver] not started. Use -ForceRestart option to restart a stopped Vserver"
            $Return=$False
        }
    }
    Write-LogDebug "end"
    Return $Return
}catch{
    handle_error $_ $myVserver
	return $Return
}
}

#############################################################################################
# Check if Primary Cluster is still alive by testing connectivity to SSH and HTTPS
Function test_primary_alive (
    [string] $PrimaryCluster,
    [string] $SecondaryCluster,
	[string] $PrimaryVserver , 
    [string] $SecondaryVserver ) 
{
    $Return = $True
    $ProgressPreference = 'SilentlyContinue'
    Write-LogDebug "start"
    $FirsTest=$False
    if ( Test-Connection -ComputerName $PrimaryCluster -Quiet ){
        $FirstTest=$True
    }else{
        Write-LogWarn "Failed to contact [$PrimaryCluster]"
    }

    $SecondTest = $False
    $myCred=get_local_cDotcred ($PrimaryCluster) 
	Write-LogDebug "connect_cluster $PrimaryCluster -myCred $MyCred -myTimeout $Global:Timeout"
	if ( ( $NcPrimaryCtrl =  connect_cluster $PrimaryCluster -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
        Write-LogError "ERROR: Unable to Connect to NcController [$PrimaryCluster]" 
        Write-LogWarn "Failed to Connect to [$PrimaryCluster]"
    }else{
        $SecondTest=$True
    }
    $myCred=get_local_cDotcred ($SecondaryCluster) 
	Write-LogDebug "connect_cluster $SecondaryCluster -myCred $MyCred -myTimeout $Global:Timeout"
	if ( ( $NcSecondaryCtrl =  connect_cluster $SecondaryCluster -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
        Write-LogError "ERROR: Unable to Connect to NcController [$SecondaryCluster]" 
        Write-Error "Unable to connect to NcController [$SecondaryCluster]"
        clean_and_exit 1
    }

    $ThirdTest=$False
    $DestinationCluster = (Get-NcCluster -controller $NcSecondaryCtrl).ClusterName
    $SVMTOOL_DB_CLUSTER=$Global:SVMTOOL_DB + '\' + $DestinationCluster + '.cluster'
    $CLUSTERINFO_SRC_FILE=$SVMTOOL_DB_CLUSTER + '\clustersrcinfo.json'
    if( ( Test-Path $CLUSTERINFO_SRC_FILE ) -eq $false){
        throw "ERROR: Unable to read [$CLUSTERINFO_SRC_FILE]"
    }
    $myClusterSrc=Get-Content $CLUSTERINFO_SRC_FILE -Raw | ConvertFrom-Json
    $myClusterSrcName=$myClusterSrc.ClusterName
    if ( ( (Ping-NcClusterPeer -Controller $NcSecondaryCtrl -Name $myClusterSrcName).PingStatus) -eq "interface_reachable" ){
        $ThirdTest=$True
    }else{
        Write-LogWarn "Ping-NcClusterPeer Failed for [$PrimaryCluster]"
    }

    $FourthTest=$False
    $ProgressPreference = 'SilentlyContinue'
    if ( Test-Connection -ComputerName $PrimaryCluster -Quiet ){
        $FourthTest=$True
    }else{
        Write-LogWarn "Test-Connection Failed for [$PrimaryCluster]"
    }
    
    if ( $FirstTest -eq $True -and $SecondTest -eq $True -and $ThirdTest -eq $True -and $FourthTest -eq $True ){
        Write-LogDebug "PrimaryCluster [$PrimaryCluster] is alive"
    }else{
        Start-Sleep -Seconds $Global:SILENT_PERIOD
        $ProgressPreference = 'SilentlyContinue'
        if ( Test-Connection -ComputerName $PrimaryCluster -Port 443 -InformationLevel Quiet ){
            $FirstTest=$True
        }else{
            Write-LogWarn "Failed to Ping [$PrimaryCluster]"
        }
        if ( ( $NcPrimaryCtrl =  connect_cluster $PrimaryCluster -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
            Write-LogError "ERROR: Unable to Connect to NcController [$PrimaryCluster]" 
            Write-LogWarn "Failed to Connect to [$PrimaryCluster]"
        }else{
            $SecondTest=$True
        }
        if ( ( (Ping-NcClusterPeer -Controller $NcSecondaryCtrl -Name $myClusterSrcName).PingStatus) -eq "interface_reachable" ){
            $ThirdTest=$True
        }else{
            Write-LogWarn "Ping-NcClusterPeer Failed for [$PrimaryCluster]"
        }
        $ProgressPreference = 'SilentlyContinue'
        if ( Test-Connection -ComputerName $PrimaryCluster -Quiet ){
            $FourthTest=$True
        }else{
            Write-LogWarn "Test-Connection Failed for [$PrimaryCluster]"
        }
        if ( $FirstTest -eq $True -and $SecondTest -eq $True -and $ThirdTest -eq $True -and $FourthTest -eq $True ){
            Write-LogDebug "PrimaryCluster [$PrimaryCluster] is alive"
        }else{
            Write-Log "PrimaryCluster [$PrimaryCluster] is not alive"
            $Return=$False
        }
    }
    Write-LogDebug "end"
	return $Return
}

#############################################################################################
Function activate_vserver_dr (
    [string] $currentPassiveController, # current secondary controller
    [string] $currentActiveController,  # current primary controller
	[string] $currentActiveVserver ,    # current primary Vserver
    [string] $currentPassiveVserver,    # current secondary Vserver
    [boolean] $ForceActivate ) 
{
	$Return = $True
	Write-LogDebug "start"
	$myCred=get_local_cDotcred ($currentPassiveController) 
	Write-LogDebug "connect_cluster $currentPassiveController -myCred $MyCred -myTimeout $Global:Timeout"
	if ( ( $NcCurrentPassiveCtrl =  connect_cluster $currentPassiveController -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
		Write-LogError "ERROR: Unable to Connect to NcController [$currentPassiveController]" 
        clean_and_exit 1
    }

    # ! ForceActivate = True meens that primary cluster and primary SVM are not joinable, crashed or destroyed
    # ! in this case we must determine, by looking at secondary LIF presence, if we will proceed with PreserveIdentity mode or not
    # ! with ForceActive = False we will determine PreserverIdentity mode by looking at same LIF (as primary) presence on Secondary SVM
    # ! so if no LIF is present on secondary SVM => we are in PreserveIdentiy Mode
    # ! if at least one same LIF is present on secondary => we are not in PreserveIdentity mode

    if ( $null -ne (Get-NcCifsServer -VserverContext $currentPassiveVserver -Controller $NcCurrentPassiveCtrl -ErrorVariable ErrorVar) ){
        $NeedCIFS=$True
    }else{
        $NeedCIFS=$False
    }

    if ( $ForceActivate ){
        # Primary not joinable
        Write-LogDebug "ForceActivate Mode "
        if($NeedCIFS){
            $ret=Get-NcNetInterface -Query @{Vserver=$currentPassiveVserver;OpStatus="up";DataProtocols="cifs|nfs|iscsi"} -Controller $NcCurrentPassiveCtrl -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
            if ($null -eq $ret){
                # No LIF UP configured with cifs or nfs or iscsi on destination SVM, so we are in PreserveIdentity mode
                $RunInPreserveIdentityMode = $True
                Write-LogDebug "No LIF found up on Passive VM, so RunInPreseveIdentityMode set to True"
            }else{
                $RunInPreserveIdentityMode = $False
                Write-LogDebug "Found one LIF up on Passive VM, so RunInPreseveIdentityMode set to False"   
            }
        }

    }else{
        # Primary joinable
        $ANS=Read-HostOptions -question "Do You really want to activate SVM [$currentPassiveVserver] from cluster [$currentPassiveController] `r`nServices will switch from [$currentActiveVserver] to [$currentPassiveVserver] ?" -options "y/n" -default "y"
        if ( $ANS -ne 'y' ) {
            Write-LogDebug "end"
            Write-Log "[$currentPassiveVserver] Activation aborted"
            return $True
        }
        Write-LogDebug "Not ForceActivate Mode "
        $myCred=get_local_cDotcred ($currentActiveController) 
        Write-LogDebug "connect_cluster $currentActiveController -myCred $MyCred -myTimeout $Global:Timeout"
        if ( ( $NcCurrentActiveCtrl =  connect_cluster $currentActiveController -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
            Write-LogError "ERROR: Unable to Connect to NcController [$currentActiveController]" 
            clean_and_exit 1
        }
        if ( $null -ne ($CIFSactive=Get-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar) ){
            $srcCIFS=$True
        }else{
            $srcCIFS=$False
        }
        $lifs=Get-NcNetInterface -Query @{Vserver=$currentActiveVserver;OpStatus="up";DataProtocols="cifs|nfs|iscsi";FirewallPolicy="mgmt*"} -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        $RunInPreserveIdentityMode = $True
        Write-LogDebug "By default RunInPreseveIdentityMode set to True"
        foreach ($lif in $lifs) {
            #Test if remote LIF is configured and if it got an APIPA IP address
            $ret=Get-NcNetInterface -Query @{InterfaceName=$($lif.InterfaceName);Vserver=$currentPassiveVserver;DataProtocols="cifs|nfs|iscsi";FirewallPolicy="mgmt*";Address="!169.254.*"} -Controller $NcCurrentPassiveCtrl -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
            if($null -ne $ret){
                # one LIF on secondary with Address different than 169.254.*.*, so we are not PreserveIdentity
                $RunInPreserveIdentityMode = $False
                Write-LogDebug "Found one LIF up on Passive VM, so RunInPreseveIdentityMode set to False" 
            }
        }
    }

    if ( ( break_snapmirror_vserver_dr -myController $NcCurrentPassiveCtrl -myPrimaryVserver $currentActiveVserver -mySecondaryVserver $currentPassiveVserver ) -ne $True ) {
        Write-LogError "ERROR: Unable to break all relations from Vserver [$currentPassiveVserver] on [$currentPassiveController]"
        $Return = $False
    }

    
    #
    if( ($RunInPreserveIdentityMode = $True) -and ($Global:UseCifsDeleteMethod.IsPresent -eq $False) ){
        Write-LogDebug "Work with CIFS modify method"
        # * backup_CIFSsymlink_on_src
        # before changing CIFS server name, we need to backup & remove all cifs symlink
        Write-LogDebug "ActivateDR in CIFS Modify mode with PreserveIdentity"
        Write-LogDebug "Backup all CIFS Symlink from current passive Vserver [$currentActiveVserver]"
        if ( ($ret=Save_Cifs_Symlink_To_JSON -myController $NcCurrentActiveCtrl -myVserver $currentActiveVserver ) -eq $False){
            Throw "ERROR: Failed to backup CIFS Symlink"    
        }
        # * remove_CIFSsymlink_on_src
        Write-LogDebug "Remove all CIFS Symlink on current passive Vserver [$currentActiveVserver]"
        Write-LogDebug "Get-NcCifsSymlink -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl | Remove-NcCifsSymlink -Controller $NcCurrentActiveCtrl -VserverContext $currentActiveVserver"
        Get-NcCifsSymlink -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl | Remove-NcCifsSymlink -Controller $NcCurrentActiveCtrl -VserverContext $currentActiveVserver -Confirm:$False

        # * CIFS_modify_source_to_tmp_name
        if($srcCIFS -eq $True){
            $CIFSactiveName=$CIFSactive.CifsServer
            $newCIFSOU=$CIFSactive.OrganizationalUnit
            $newCIFSDomain=$CIFSactive.Domain
            $ADCred = get_local_cred ($newCIFSDomain)
            $newCIFSName=$("RMTACT_"+$CIFSactiveName)
            if($newCIFSName.length -gt 15){$newCIFSName=$newCIFSName.Substring(0,15)}
            Write-Log "[$currentActiveVserver] Set CIFS server up with identity [$newCIFSName]"
            Write-LogDebug "Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl"
            $out=Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar -Confirm:$False
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Stop-NcCifsServer failed [$ErrorVar]" }
            Write-LogDebug "Set-NcCifsServer -AdministrativeStatus down -ForceAccountOverwrite -CifsServer $newCIFSName -Ou $newCIFSOU -Domain $newCIFSDomain -AdminCredential $ADCred -VserverContext $currentActiveVserver -controller $NcCurrentActiveCtrl"
            $out=Set-NcCifsServer -AdministrativeStatus "down" -ForceAccountOverwrite -CifsServer $newCIFSName -Ou $newCIFSOU -Domain $newCIFSDomain -AdminCredential $ADCred -VserverContext $currentActiveVserver -controller $NcCurrentActiveCtrl  -ErrorVariable ErrorVar  -Confirm:$False
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Set-NcCifsServer failed [$ErrorVar]" }
        }

        # Analyse CIFS modifying Job
        if( (wait_cifs_modify_job -myController $NcCurrentActiveCtrl) -eq $False){
            throw "ERROR: a CIFS Modifying Job is running too long or Failed"
        }

        # * backup_lif_on_src
        $PrimaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $currentActiveVserver -DataProtocols cifs,nfs,none,iscsi -Controller $NcCurrentActiveCtrl  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        $SecondaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $currentPassiveVserver -DataProtocols cifs,nfs,none,iscsi -Controller $NcCurrentPassiveCtrl  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        if ( ($ret=Save_LIF_To_JSON -myPrimaryController $NcCurrentActiveCtrl -mySecondaryController $NcCurrentPassiveCtrl -myPrimaryNetList $PrimaryInterfaceList -mySecondaryNetList $SecondaryInterfaceList -myPrimaryVserver $currentActiveVserver -mySecondaryVserver $currentPassiveVserver) -eq $False){
            Write-Log "Failed to Backup LIF details to JSON"
            return $False
        }

        # * remove_lif_on_src
        # remove LIF on Primary
        Get-NcNetInterface -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -Role "data" | ForEach-Object {
            $lifname=$_.InterfaceName
            Write-Log "[$currentActiveVserver] Remove LIF [$lifname]"
            Write-LogDebug "Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus down"
            $ret=Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus "down" -Controller $NcCurrentActiveCtrl
            if($? -ne $True){$Return = $False; throw "ERROR: failed to set down lif [$lifname] on [$currentActiveVserver]"}
            Write-LogDebug "Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl"
            $ret=Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl -Confirm:$False
            if($? -ne $True){$Return = $False; throw "ERROR: failed to remove CIFS server on [$currentActiveVserver]"}
        }

        # * set_lif_dst_with_source_identity
        # modify active LIF on secondary with primary settings
        Write-Log "[$currentPassiveVserver] Modify LIF"
        if( ($ret=Set_LIF_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
            Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"	
        }

        # * CIFS_modif_dest_to_source_name
        # add new cifs server with primary identity on active svm
        Write-Log "[$currentPassiveVserver] Modify existing CIFS server"
        if( ($ret=Set_CIFS_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
            Throw "ERROR: Failed to set new CIFS server on [$currentPassiveVserver]"
        }

        # * modify_CIFSsymlink_on_dst
        # ! previous steps are managed inside Set_CIFS_from_JSON
    }
    if( ($RunInPreserveIdentityMode = $True) -and ($Global:UseCifsDeleteMethod.IsPresent -eq $True) ){
        Write-LogDebug "Work with CIFS delete method"
        # * backup_CIFSsymlink_on_src
        # before changing CIFS server name, we need to backup & remove all cifs symlink
        Write-LogDebug "Backup all CIFS Symlink from current passive Vserver [$currentActiveVserver]"
        if ( ($ret=Save_Cifs_Symlink_To_JSON -myController $NcCurrentActiveCtrl -myVserver $currentActiveVserver ) -eq $False){
            Throw "ERROR: Failed to backup CIFS Symlink"    
        }
        # * remove_CIFSsymlink_on_src
        Write-LogDebug "Remove all CIFS Symlink on current passive Vserver [$currentActiveVserver]"
        Write-LogDebug "Get-NcCifsSymlink -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl | Remove-NcCifsSymlink -Controller $NcCurrentActiveCtrl -VserverContext $currentActiveVserver"
        Get-NcCifsSymlink -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl | Remove-NcCifsSymlink -Controller $NcCurrentActiveCtrl -VserverContext $currentActiveVserver -Confirm:$False

        # * remove_CIFS_on_src
        # remove primary CIFS server : current active
        if ( $null -ne (Get-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar) ){
            Write-Log "[$currentActiveVserver] Remove CIFS server"
            Write-LogDebug "Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl"
            $ret=Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar -Confirm:$False
            if($? -ne $True){$Return = $False; throw "ERROR: failed to stop secondary CIFS server"}
            Write-LogDebug "Remove-NcCifsServer -VserverContext $currentActiveVserver -ForceAccountDelete -Controller $NcCurrentActiveCtrl"
            $ret=Remove-NcCifsServer -VserverContext $currentActiveVserver -ForceAccountDelete -Controller $NcCurrentActiveCtrl -Confirm:$False -ErrorVariable ErrorVar
            if($? -ne $True){$Return = $False; throw "ERROR: failed to remove secondary CIFS server"}	
            $NeedCIFS=$True
        }

        # * backup_lif_on_src
        $PrimaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $currentActiveVserver -DataProtocols cifs,nfs,none,iscsi -Controller $NcCurrentActiveCtrl  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        $SecondaryInterfaceList = Get-NcNetInterface -Role DATA -VserverContext $currentPassiveVserver -DataProtocols cifs,nfs,none,iscsi -Controller $NcCurrentPassiveCtrl  -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcNetInterface failed [$ErrorVar]" }
        if ( ($ret=Save_LIF_To_JSON -myPrimaryController $NcCurrentActiveCtrl -mySecondaryController $NcCurrentPassiveCtrl -myPrimaryNetList $PrimaryInterfaceList -mySecondaryNetList $SecondaryInterfaceList -myPrimaryVserver $currentActiveVserver -mySecondaryVserver $currentPassiveVserver) -eq $False){
            Write-Log "Failed to Backup LIF details to JSON"
            return $False
        }

        # * remove_lif_on_src
        # remove LIF on Primary
        Get-NcNetInterface -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -Role "data" | ForEach-Object {
            $lifname=$_.InterfaceName
            Write-Log "[$currentActiveVserver] Remove LIF [$lifname]"
            Write-LogDebug "Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus down"
            $ret=Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus "down" -Controller $NcCurrentActiveCtrl
            if($? -ne $True){$Return = $False; throw "ERROR: failed to set down lif [$lifname] on [$currentActiveVserver]"}
            Write-LogDebug "Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl"
            $ret=Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl -Confirm:$False
            if($? -ne $True){$Return = $False; throw "ERROR: failed to remove CIFS server on [$currentActiveVserver]"}
        }

        # * Stop primary current active SVM
        Write-Log "[$currentActiveVserver] stop Vserver"
		Write-LogDebug "Stop-NcVserver -Name $currentActiveVserver -Controller $NcCurrentActiveCtrl"
		$ret=Stop-NcVserver -Name $currentActiveVserver -Controller $NcCurrentActiveCtrl -Confirm:$False
		if($? -ne $True){Throw "ERROR: Failed to stop Vserver [$currentActiveVserver]"}
        Start-Sleep 1

        # * set_lif_dst_with_source_identity
		# modify secondary LIF with primary settings
        Write-Log "[$currentPassiveVserver] Modify LIF"
        if( ($ret=Set_LIF_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
            Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"		
        }

        # * CIFS_recreate_from_JSON_src_on_dst
        # add new cifs server with primary identity on active svm
        Write-Log "[$currentPassiveVserver] Register new CIFS server"
        if( ($ret=Set_CIFS_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
            Throw "ERROR: Failed to set new CIFS server on [$currentPassiveVserver]"
        }

        # * CIFS_shares_recreate_from_JSON_src_on_dst
        # * recreate_CIFSsymlink_from_JSON_src_on_dst
        # ! previous steps are managed inside Set_CIFS_from_JSON
    }
    if($RunInPreserveIdentityMode = $False){
        # * set_LIF_up_on_dst
        Get-NcNetInterface -vserver $currentPassiveVserver -Controller $NcCurrentPassiveCtrl -DataProtocols !none | Set-NcNetInterface -Vserver $currentPassiveVserver -Controller $NcCurrentPassiveCtrl -AdministrativeStatus "up" -ErrorVariable ErrorVar
        if($? -ne $true){
            Write-LogError "ERROR: failed to set lif up on [$currentPassiveVserver] reason [$ErrorVar]"
        }
        # * CIFS_start_on_dst
        $out=Start-NcCifsServer -VserverContext $currentPassiveVserver -Controller $NcCurrentPassiveCtrl -ErrorVariable ErrorVar 
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Start-NcCifsServer failed [$ErrorVar]" }

    }

	# enable services on secondary
    if ( ( $ret=enable_network_protocol_vserver_dr -myNcController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver ) -ne $True ) {
        Write-LogError "ERROR: Unable to Start all NetWork Protocols in Vserver [$currentPassiveVserver] on [$currentPassiveController]"
        $Return = $False
    }
    if ( ( $ret=set_vol_options_from_voldb -myController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver ) -ne $True ) {
        Write-LogError "ERROR: set_vol_options_from_voldb failed"
    }
    if ( $AllowQuotaDR -eq "True" ) {
        if ( ( $ret=create_quota_rules_from_quotadb -myController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver  ) -ne $True ) {
            Write-LogError "ERROR: create_quota_rules_from_quotadb failed"
        }
    }

    if ( ($ret = disable_network_protocol_vserver_dr -myController $NcCurrentActiveCtrl -myVserver $currentActiveVserver -ForceDisable) -eq $False) {
        Throw "ERROR: Failed to disable all services on [$currentActiveVserver]"
    }

    Write-LogDebug "end"
    return $Return
}
    

#############################################################################################
Function activate_vserver_dr_old (
    [string] $currentPassiveController, # current secondary controller
    [string] $currentActiveController,  # current primary controller
	[string] $currentActiveVserver ,    # current primary Vserver
    [string] $currentPassiveVserver,    # current secondary Vserver
    [boolean] $ForceActivate ) 
{
	$Return = $True
	Write-LogDebug "start"
	$myCred=get_local_cDotcred ($currentPassiveController) 
	Write-LogDebug "connect_cluster $currentPassiveController -myCred $MyCred -myTimeout $Global:Timeout"
	if ( ( $NcCurrentPassiveCtrl =  connect_cluster $currentPassiveController -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
		Write-LogError "ERROR: Unable to Connect to NcController [$currentPassiveController]" 
        clean_and_exit 1
    }
	
	if ( $ForceActivate ){
        if ( ( break_snapmirror_vserver_dr -myController $NcCurrentPassiveCtrl -myPrimaryVserver $currentActiveVserver -mySecondaryVserver $currentPassiveVserver ) -ne $True ) {
            Write-LogError "ERROR: Unable to break all relations from Vserver [$currentPassiveVserver] on [$currentPassiveController]"
            $Return = $False
        }
		$NeedCIFS=$False
        # remove dest CIFS server
        if ( $null -ne (Get-NcCifsServer -VserverContext $currentPassiveVserver -Controller $NcCurrentPassiveCtrl -ErrorVariable ErrorVar) ){
            $NeedCIFS=$True
        }
        if( $Global:PreserveIdentity -eq $True ){
            # modify active LIF on secondary with primary settings
            Write-Log "[$currentPassiveVserver] Modify LIF"
            if( ($ret=Set_LIF_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
                Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"	
            }
        }
		if($NeedCIFS){
            if( $Global:PreserveIdentity -eq $True ){
                # add new cifs server with primary identity on active svm
                Write-Log "[$currentPassiveVserver] Register new CIFS server"
                if( ($ret=Set_CIFS_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
                    Throw "ERROR: Failed to set new CIFS server on [$currentPassiveVserver]"
                }
            }
        }
        
	}else{
        $ANS=Read-HostOptions -question "Do You really want to activate SVM [$currentPassiveVserver] from cluster [$currentPassiveController] `r`nServices will switch from [$currentActiveVserver] to [$currentPassiveVserver] ?" -options "y/n" -default "y"
        if ( $ANS -ne 'y' ) {
            Write-LogDebug "end"
            Write-Log "[$currentPassiveVserver] Activation aborted"
            return $True
        }
        if ( ( break_snapmirror_vserver_dr -myController $NcCurrentPassiveCtrl -myPrimaryVserver $currentActiveVserver -mySecondaryVserver $currentPassiveVserver ) -ne $True ) {
            Write-LogError "ERROR: Unable to break all relations from Vserver [$currentPassiveVserver] on [$currentPassiveController]"
            $Return = $False
        }
		$myCred=get_local_cDotcred ($currentActiveController) 
		$tmp_str=$MyCred.UserName
		Write-LogDebug "Connect to cluster [$currentActiveController] with login [$tmp_str]"
		Write-LogDebug "connect_cluster $currentActiveController -myCred $MyCred -myTimeout $Global:Timeout"
		if ( ( $NcCurrentActiveCtrl =  connect_cluster $currentActiveController -myCred $MyCred -myTimeout $Global:Timeout ) -eq $False ) {
			Write-LogError "ERROR: Unable to Connect to NcController [$currentActiveController]" 
				clean_and_exit 1
		}
        $NeedCIFS=$False
        if( $Global:PreserveIdentity -eq $True ){
            # remove primary CIFS server : current active
            if ( $null -ne (Get-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar) ){
                Write-Log "[$currentActiveVserver] Remove CIFS server"
                Write-LogDebug "Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl"
                $ret=Stop-NcCifsServer -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -ErrorVariable ErrorVar -Confirm:$False
                if($? -ne $True){$Return = $False; throw "ERROR: failed to stop secondary CIFS server"}
                Write-LogDebug "Remove-NcCifsServer -VserverContext $currentActiveVserver -ForceAccountDelete -Controller $NcCurrentActiveCtrl"
                $ret=Remove-NcCifsServer -VserverContext $currentActiveVserver -ForceAccountDelete -Controller $NcCurrentActiveCtrl -Confirm:$False -ErrorVariable ErrorVar
                if($? -ne $True){$Return = $False; throw "ERROR: failed to remove secondary CIFS server"}	
			    $NeedCIFS=$True
            }
            # remove LIF on Primary
            Get-NcNetInterface -VserverContext $currentActiveVserver -Controller $NcCurrentActiveCtrl -Role "data" | ForEach-Object {
                $lifname=$_.InterfaceName
                Write-Log "[$currentActiveVserver] Remove LIF [$lifname]"
                Write-LogDebug "Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus down"
                $ret=Set-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -AdministrativeStatus "down" -Controller $NcCurrentActiveCtrl
                if($? -ne $True){$Return = $False; throw "ERROR: failed to set down lif [$lifname] on [$currentActiveVserver]"}
                Write-LogDebug "Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl"
                $ret=Remove-NcNetInterface -Name $lifname -Vserver $currentActiveVserver -Controller $NcCurrentActiveCtrl -Confirm:$False
                if($? -ne $True){$Return = $False; throw "ERROR: failed to remove CIFS server on [$currentActiveVserver]"}
            }
        }
        # stop primary SVM
        Write-Log "[$currentActiveVserver] stop Vserver"
		Write-LogDebug "Stop-NcVserver -Name $currentActiveVserver -Controller $NcCurrentActiveCtrl"
		$ret=Stop-NcVserver -Name $currentActiveVserver -Controller $NcCurrentActiveCtrl -Confirm:$False
		if($? -ne $True){Throw "ERROR: Failed to stop Vserver [$currentActiveVserver]"}
        Start-Sleep 1
		# remove secondary CIFS server
		if( $Global:PreserveIdentity -eq $True ){
            # modify secondary LIF with primary settings
            Write-Log "[$currentPassiveVserver] Modify LIF"
            if( ($ret=Set_LIF_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
                Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"	
			Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"	
                Throw "ERROR: Failed to set IP address on [$currentPassiveVserver]"	
            }
        }
		if($NeedCIFS){
            if( $Global:PreserveIdentity -eq $True ){
                # change CIFS server name on destination
                Write-Log "[$currentPassiveVserver] Register new CIFS server"
                if( ($ret=Set_CIFS_from_JSON -ToNcController $NcCurrentPassiveCtrl -ToVserver $currentPassiveVserver -fromSrc) -eq $False ){
                    Throw "ERROR: Failed to add new CIFS server on [$currentPassiveVserver]"
                }
            }
		}
	} # end case ForceActivate

    # enable services on secondary
    if ( ( $ret=enable_network_protocol_vserver_dr -myNcController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver ) -ne $True ) {
		Write-LogError "ERROR: Unable to Start all NetWork Protocols in Vserver [$currentPassiveVserver] on [$currentPassiveController]"
		$Return = $False
    }
    if ( ( $ret=set_vol_options_from_voldb -myController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver ) -ne $True ) {
		Write-LogError "ERROR: set_vol_options_from_voldb failed"
	}
	if ( $AllowQuotaDR -eq "True" ) {
		if ( ( $ret=create_quota_rules_from_quotadb -myController $NcCurrentPassiveCtrl -myVserver $currentPassiveVserver  ) -ne $True ) {
			Write-LogError "ERROR: create_quota_rules_from_quotadb failed"
		}
	}

    Write-LogDebug "end"
	return $Return
}

#############################################################################################
Function resync_reverse_vserver_dr (
	[NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
	[NetApp.Ontapi.Filer.C.NcController] $mySecondaryController,
	[string] $myPrimaryVserver ,
	[string] $mySecondaryVserver ) 
{
    Try { 

	    $Return = $True 

	    $myPrimaryCluster = (Get-NcCluster -Controller $myPrimaryController  -ErrorVariable ErrorVar).ClusterName			
	    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCluster failed [$ErrorVar]" }
	    $mySecondaryCluster = (Get-NcCluster -Controller $mySecondaryController  -ErrorVariable ErrorVar).ClusterName			
	    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCluster failed [$ErrorVar]" }

	    Write-LogDebug "start"
        # check current normal relationships
	    Write-LogDebug "Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController"
	    $relationList = Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar
        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcSnapmirror failed [$ErrorVar]" }
        if ( $Global:ForceRecreate -and ( $relationList -eq $null ) )
        {
            if ( ( create_snapmirror_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -Force -DDR $False ) -ne $True ) 
            { 
                Write-LogError "ERROR: Failed to recreate all snapmirror relations "
                return $False
            }
            Write-LogDebug "Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController"
	        $relationList = Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar
            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcSnapmirror failed [$ErrorVar]" }          
        }

        # Process all existing normal relationship

	    foreach ( $relation in ( $relationList | Skip-Null ) ) 	{
		    $MirrorState=$relation.MirrorState
		    $SourceVolume=$relation.SourceVolume
            $SourceCluster=$relation.SourceCluster
            $DestinationCluster=$relation.DestinationCluster
		    $DestinationVolume=$relation.DestinationVolume
            $SourceVserver=$relation.SourceVserver
            $DestinationVserver=$relation.DestinationVserver
		    $SourceLocation=$relation.SourceLocation
		    $DestinationLocation=$relation.DestinationLocation
		    $RelationshipStatus=$relation.RelationshipStatus
			$RelationshipType=$relation.RelationshipType
            $RelationshipSchedule=$relationship.Schedule
            $RelationPolicy=$relation.Policy
            $myPrimaryControllerName=$myPrimaryController.Name
            $mySecondaryControllerName=$mySecondaryController.Name
            $RelationGroupType=$relation.RelationshipGroupType

            # define which snapmirror policy will be use if creates new relationship
            # If a Global XDPPolicy was provided, we will choose this one
            # If no Global XDPPolicy provided, we will use the policy of the previous relationship
            # Without previous relationship, we will use the default policy MirrorAndVault

            if($Global:XDPPolicy.Length -gt 0){
                $SnapmirrorPolicy=$Global:XDPPolicy
            }elseif($RelationPolicy.Length -gt 0){
                $SnapmirrorPolicy=$RelationPolicy
            }else{
                $SnapmirrorPolicy="MirrorAndVault"
            }
            if($Global:MirrorSchedule.Length -gt 0){
                $SnapmirrorSchedule=$Global:MirrorSchedule
            }elseif($RelationshipSchedule.Length -gt 0){
                $SnapmirrorSchedule=$RelationshipSchedule
            }else{
                $SnapmirrorSchedule="hourly"
            }
            Write-LogDebug "Will use Snapmirror Policy [$SnapmirrorPolicy]  & Schedule [$SnapmirrorSchedule]"

            # In ForceRecrate mode existing Reversed Relationship are remove
            
            if($Global:ForceRecreate)
            {
                Write-LogDebug "Get-NcSnapmirror -DestinationLocation $SourceLocation -Controller $myPrimaryController"
                $ExistingReverseRelationShip=Get-NcSnapmirror -DestinationLocation $SourceLocation -Controller $myPrimaryController  -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcSnapmirror failed [$ErrorVar]" }
                if($null -ne $ExistingReverseRelationShip)
                {
                    $ExistingReverseRelationShipDestVolume=$ExistingReverseRelationShip.DestinationVolume
                    $ExistingReverseRelationShipDestVserver=$ExistingReverseRelationShip.DestinationVserver
                    Write-LogDebug "Remove-NcSnapmirror -DestinationVserver $ExistingReverseRelationShipDestVserver -DestinationVolume $ExistingReverseRelationShipDestVolume -controller $myPrimaryController"
                    $out=Remove-NcSnapmirror -DestinationVserver $ExistingReverseRelationShipDestVserver -DestinationVolume $ExistingReverseRelationShipDestVolume -controller $myPrimaryController  -ErrorVariable ErrorVar -Confirm:$False   
                    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Remove-NcSnapmirror failed [$ErrorVar]" } 
                }
            }

            # For Sync relationship and relationship based on Flexgroup we first need to
            # Remove relationship from dest
            # Release relationship information only from source

            if( $RelationPolicy -in $("Sync","StrictSync") -or ( $RelationGroupType -eq "flexgroup" ) ){
                # In Sync or StrictSync or with flexgroup relationships to perform a flip resync at this step, we need to :
                # relationship already quiesced and broken
                # we need first to:
                # delete relationship from dest
                # release info-only from source
                Write-LogDebug "Remove-NcSnapmirror -Destination $DestinationLocation -Controller $mySecondaryController -Confirm:$False"
                $ret=Remove-NcSnapmirror -Destination $DestinationLocation -Controller $mySecondaryController -Confirm:$False -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Remove-NcSnapmirror failed [$ErrorVar]" }
                Write-LogDebug "Invoke-NcSnapmirrorRelease -RelationshipInfoOnly -Destination $DestinationLocation -Controller $myPrimaryController -Confirm:$False "
                $ret=Invoke-NcSnapmirrorRelease -RelationshipInfoOnly -Destination $DestinationLocation -Controller $myPrimaryController -Confirm:$False -ErrorVariable ErrorVar -ErrorAction SilentlyContinue
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Invoke-NcSnapmirrorRelease failed [$ErrorVar]" } 
            }

            # Normal relationship must be broken-off idle, before continuing

		    if ( ( $MirrorState -eq 'broken-off' ) -and ($RelationshipStatus -eq 'idle' ) ) 
            {
			    Write-LogDebug "Get-NcSnapmirror -SourceLocation $DestinationLocation -DestinationLocation $SourceLocation -Controller $myPrimaryController"
			    $reverseRelation=Get-NcSnapmirror -SourceLocation $DestinationLocation -DestinationLocation $SourceLocation -Controller $myPrimaryController  -ErrorVariable ErrorVar
                if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcSnapmirror failed [$ErrorVar]" }
                
                # if reverse relationship alreay exist, so resyncs it

			    if ( $reverseRelation -ne $null ) 
                {
                    $ReverseRelationshipStatus=$reverseRelation.RelationshipStatus
				    $ReverseMirrorState=$reverseRelation.MirrorState
                    $ReverseHealth=$reverseRelation.IsHealthy
                    $ReverseRelationDestinationVserver=$reverseRelation.DestinationVserver
				    Write-Log "[$ReverseRelationDestinationVserver] Reverse Relation [$DestinationLocation] --> [$SourceLocation] already exists [$ReverseRelationshipStatus] [$ReverseMirrorState]" 
				    if ( ( $ReverseRelationshipStatus -ne 'idle' ) -and ( $ReverseMirrorState -ne 'snapmirrored' ) ) 
                    {
					    Write-LogWarn "Reverse Relation status is [$ReverseRelationshipStatus] [$ReverseMirrorState], must be broken before resync reverse"
					    $Return = $False
				    }
                    if ($ReverseHealth -eq $False)
                    {
                        Write-LogWarn "Reverse Relation is not Healthy [$ReverseRelationshipStatus] [$ReverseMirrorState] Please check on controller [$myPrimaryController]"
					    $Return = $False    
                    }
				    Write-Log "[$ReverseRelationDestinationVserver] Resync Relation [$DestinationLocation] --> [$SourceLocation]"
				    Write-LogDebug "Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation  -Controller $myPrimaryController"
				    $out=Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation -Controller $myPrimaryController  -ErrorVariable ErrorVar
				    if ( $? -ne $True ){Write-LogError "ERROR: snapmirror Resync Failed";$Return = $False}
			    } 
                else  # reverse relationship does not exist, so creates it 
                {
                    if($RelationshipType -eq "extended_data_protection")
                    {
                        <# if($Global:XDPPolicy -ne ""){
                            Write-LogDebug "Snapmirror Policy set to [$($Global:XDPPolicy)]"
                            $SnapmirrorPolicy=$Global:XDPPolicy
                        }else{
                            Write-LogDebug "Snapmirror Policy set to default [MirrorAllSnapshots]"
                            $SnapmirrorPolicy="MirrorAllSnapshots"    
                        } #>
                        Write-Log "[$SourceVserver] Create Reverse VF SnapMirror [${mySecondaryControllerName}:${DestinationVserver}/$DestinationVolume] --> [${myPrimaryControllerName}:${SourceVserver}/$SourceVolume]"
                        if($RelationPolicy -notin $("Sync","StrictSync")){
                            Write-LogDebug "New-NcSnapmirror -Type vault -Policy $SnapmirrorPolicy -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Schedule $SnapmirrorSchedule -Controller $myPrimaryController "
                            $relation=New-NcSnapmirror -Type vault -Policy $SnapmirrorPolicy -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Schedule $SnapmirrorSchedule -Controller $myPrimaryController  -ErrorVariable ErrorVar     
                            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: New-NcSnapmirror failed [$ErrorVar]" }
                            #Write-Log "Reverse resync [${DestinationCluster}://${DestinationVserver}/$DestinationVolume] -> [${SourceCluster}://${SourceVserver}/$SourceVolume]"
                            Write-LogDebug "Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation  -Controller $myPrimaryController"
                            $out=Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation -Controller $myPrimaryController  -ErrorVariable ErrorVar
                            if ( $? -ne $True ){Write-LogError "ERROR: snapmirror Resync Failed";$Return = $False}
                        }else{
                            Write-LogDebug "Reverse Resync a SM-S relationship"
                            Write-LogDebug "New-NcSnapmirror -Type vault -Policy $SnapmirrorPolicy -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController "
                            $relation=New-NcSnapmirror -Type vault -Policy $SnapmirrorPolicy -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController  -ErrorVariable ErrorVar     
                            if ( $? -ne $True ) { $Return = $False ; throw "ERROR: New-NcSnapmirror failed [$ErrorVar]" }
                        }
                    }else{
                        Write-Log "[$SourceVserver] Create Reverse SnapMirror [${DestinationCluster}:${DestinationVserver}/$DestinationVolume] --> [${SourceCluster}:${SourceVserver}/$SourceVolume]"
                        if($RelationshipSchedule -ne $null){
                            Write-LogDebug "New-NcSnapmirror -Type DP -Policy DPDefault -Schedule $RelationshipSchedule -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController "
        			        $relation=New-NcSnapmirror -Type dp -Policy DPDefault -Schedule $RelationshipSchedule -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController  -ErrorVariable ErrorVar 
        			        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: New-NcSnapmirror failed [$ErrorVar]" }
                        }else{
                            Write-LogDebug "New-NcSnapmirror -Type DP -Policy DPDefault -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController "
        			        $relation=New-NcSnapmirror -Type dp -Policy DPDefault -DestinationVserver $SourceVserver -DestinationVolume $SourceVolume -SourceVserver $DestinationVserver -SourceVolume $DestinationVolume -Controller $myPrimaryController  -ErrorVariable ErrorVar 
        			        if ( $? -ne $True ) { $Return = $False ; throw "ERROR: New-NcSnapmirror failed [$ErrorVar]" }
                        }
                        Write-Log "Reverse resync [${DestinationCluster}:${DestinationVserver}/$DestinationVolume] --> [${SourceCluster}:${SourceVserver}/$SourceVolume]"
                        Write-LogDebug "Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation  -Controller $myPrimaryController"
				        $out=Invoke-NcSnapmirrorResync -Source $DestinationLocation -Destination $SourceLocation -Controller $myPrimaryController  -ErrorVariable ErrorVar
				        if ( $? -ne $True ){Write-LogError "ERROR: snapmirror Resync Failed";$Return = $False}    
                    }
                    <#else{
				        $ReverseRelationshipStatus=$reverseRelation.RelationshipStatus
				        $ReverseMirrorState=$reverseRelation.MirrorState
                        $ReverseHealth=$reverseRelation.IsHealthy
				        Write-Log "Reverse Relation [$DestinationLocation] [$SourceLocation] already exists [$ReverseRelationshipStatus] [$ReverseMirrorState]" 
				        if ( ( $ReverseRelationshipStatus -ne 'idle' ) -and ( $ReverseMirrorState -ne 'snapmirrored' ) ) 
                        {
					        Write-LogWarn "Reverse Relation status is [$ReverseRelationshipStatus] [$ReverseMirrorState]"
					        $Return = $False
				        }
                        if ($ReverseHealth -eq $False)
                        {
                            Write-LogWarn "Reverse Relation is not Healthy [$ReverseRelationshipStatus] [$ReverseMirrorState] Please check on controller [$mySecondaryController]"
					        $Return = $False    
                        }
                    }#>
			    }
		    } 
            else 
            {
			    Write-LogError "ERROR: The relation [$SourceLocation] --> [$DestinationLocation] status is [$RelationshipStatus] [$MirrorState]" 
			    $Return = $False
		    }
        }
        
        # check if there is previously created reverse relationship that need to be resync
        # compare number of normals relationshisp and reverses relationships
        # and resync existing reverse relationship 
        # usefull for flexgroup relationship only

        $NumberOfNormalRelationships=$relationList.count
        $AllExistingReverseRelationships=Get-NcSnapmirror -VserverContext $myPrimaryVserver -Query @{MirrorState="snapmirrored|broken-off";RelationshipStatus="idle"} -Controller $myPrimaryController  -ErrorVariable ErrorVar
        $NumberOfReversedRelationships=$AllExistingReverseRelationships.count
        if( $null -ne $NumberOfReversedRelationships ){
            if($NumberOfNormalRelationships -ne $NumberOfReversedRelationships){
                #$Difference=$NumberOfReversedRelationships-$NumberOfNormalRelationships
                if(($null -ne $relationList) -and ($null -ne $AllExistingReverseRelationships)){
                $MissingRelationship=Compare-Object -ReferenceObject $relationList -DifferenceObject $AllExistingReverseRelationships -Property DestinationVolume,SourceVolume
                #if( ($MissingRelationship | Measure-Object).count -eq $Difference ){
                    foreach( $missing in $MissingRelationship | where-object {$_.SideIndicator -eq "=>"} ){
                        #if($missing.SideIndicator -eq "=>"){
                            $SourceVolume=$missing.SourceVolume
                            $DestinationVolume=$missing.DestinationVolume
                            $relation=$AllExistingReverseRelationships | where-object  {$_.SourceVolume -eq $SourceVolume -and $_.DestinationVolume -eq $DestinationVolume}
                            $SourceLocation=$relation.SourceLocation
                            $DestinationLocation=$relation.DestinationLocation
                            $DestinationVserver=$relation.DestinationVserver
                            Write-Log "[$DestinationVserver] Force resync on existing reversed relationship between [$SourceLocation] --> [$DestinationLocation]"
                            $ret=Invoke-NcSnapmirrorResync -Source $SourceLocation -Destination $DestinationLocation -Controller $myPrimaryController -ErrorVariable ErrorVar
                            if ( $? -ne $True ){Write-LogError "ERROR: snapmirror Resync Failed [$ErrorVar]";$Return = $False}
                            $Return=$True
                        <# }else{
                            Write-LogDebug "WARNING: Check direction of missing relationships"
                            Write-LogDebug "[$missing]"
                        } #>
                    }
                }elseif($null -ne $AllExistingReverseRelationships){
                    $ret=($ExistingReverseRelationships | Invoke-NcSnapmirrorResync -Controller $myPrimaryController -ErrorVariable ErrorVar)   
                    #Get-NcSnapmirror -VserverContext $myPrimaryVserver -Query @{MirrorState="snapmirrored|broken-off";RelationshipStatus="idle"} -Controller $myPrimaryController  -ErrorVariable ErrorVar | Invoke-NcSnapmirrorResync -Controller $myPrimaryController -ErrorVariable ErrorVar    
                    $Return=$True
                }elseif($null -ne $MissingRelationship){
                    Write-LogWarn "Check missing relationships to resync"
                    Write-LogDebug "[$MissingRelationship]"
                    $Return=$False
                }
            }elseif(($ExistingReverseRelationShip.MirrorState -eq "broken-off").count -ge 1){
                Write-LogDebug "Force Resync of present reversed relationship on [$myPrimaryController]"
                $ret=($ExistingReverseRelationShip | Invoke-NcSnapmirrorResync -Controller $myPrimaryController)
                $Return=$True
            }
        }

	    return $Return 
    }
    Catch 
    {
        handle_error $_ $myPrimaryVserver
	    return $Return
    }
}

#############################################################################################
Function resync_vserver_dr (
	[NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
	[NetApp.Ontapi.Filer.C.NcController] $mySecondaryController,
	[string] $myPrimaryVserver,
	[string] $mySecondaryVserver ) 
{
    Try 
    {
    	$Return = $True

    	$myPrimaryCluster = (Get-NcCluster -Controller $myPrimaryController  -ErrorVariable ErrorVar).ClusterName			
    	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCluster failed [$ErrorVar]" }
    	$mySecondaryCluster = (Get-NcCluster -Controller $mySecondaryController  -ErrorVariable ErrorVar).ClusterName			
    	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcCluster failed [$ErrorVar]" }
        if($Global:ForceRecreate)
        {
            #Write-Log "Recreate relationship from $myPrimaryVserver to $mySecondaryVserver"
            if ( ( create_snapmirror_dr -myPrimaryController $myPrimaryController -mySecondaryController $mySecondaryController -myPrimaryVserver $myPrimaryVserver -mySecondaryVserver $mySecondaryVserver -Force -DDR $False ) -ne $True ) 
            { 
                Write-LogError "ERROR: Failed to recreate all snapmirror relations "
                return $False
            }
        }
    	Write-LogDebug "Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController"
    	$relationList = Get-NcSnapmirror -DestinationVserver $mySecondaryVserver -SourceVserver $myPrimaryVserver -Controller $mySecondaryController  -ErrorVariable ErrorVar
    	if ( $? -ne $True ) 
        { $Return = $False ; throw "ERROR: Get-NcSnapmirror failed [$ErrorVar]" }
        if($null -eq $relationList -and -not $Global:ForceRecreate){
            Write-Log "There is no snapmirror relationship between primary and secondary, you have to force the recreation of these with the [ForceRecreate] option"
        }
    	foreach ( $relation in ( $relationList | Skip-Null ) ) 
        {
    		$MirrorState=$relation.MirrorState
    		$SourceVolume=$relation.SourceVolume
    		$DestinationVolume=$relation.DestinationVolume
    		$SourceLocation=$relation.SourceLocation
    		$DestinationLocation=$relation.DestinationLocation
    		$RelationshipStatus=$relation.RelationshipStatus
            $RelationHealth=$relation.IsHealthy
    		
    		if ( ( $MirrorState -match 'broken-off|snapmirrored' ) -and ($RelationshipStatus -eq 'idle' ) ) 
            {
    			Write-Log "[$mySecondaryVserver] Resync relationship [$SourceLocation] --> [$DestinationLocation] "
    			Write-LogDebug "Invoke-NcSnapmirrorResync -Source $SourceLocation -Destination $DestinationLocation  -Controller $mySecondaryController"
    			$out=Invoke-NcSnapmirrorResync -Source $SourceLocation -Destination $DestinationLocation  -Controller $mySecondaryController  -ErrorVariable ErrorVar -Confirm:$False
    			if ( $? -ne $True ) 
                {
    				Write-LogError "ERROR: Snapmirror Resync failed" 
    				$Return = $False
    			}
    		} 
            elseif ( ( $MirrorState -eq 'snapmirrored' ) -and ( ( $RelationshipStatus -eq 'idle' ) -or (( $RelationshipStatus -eq 'transferring' ) -and ( $MirrorState -eq 'broken-off') ) ) ) 
            {
    			Write-Log "The relation [$SourceLocation] [$DestinationLocation] status is [$RelationshipStatus] [$MirrorState] " 
    		} 
            elseif ( $RelationHealth -eq $False )
            {
                Write-LogWarn "The relation [$SourceLocation] [$DestinationLocation] is not healthy, check status"
            }
            else 
            {
    			Write-LogError "ERROR: The relation [$SourceLocation] [$DestinationLocation] status is [$RelationshipStatus] [$MirrorState] " 
    			$Return = $False
    		}			
        }
        return $Return
    }
    Catch 
    {
        handle_error $_ $myPrimaryVserver
    	return $Return
    }
}

#############################################################################################
Function svmdr_db_check (
	[NetApp.Ontapi.Filer.C.NcController] $myController,
	[string]$myVserver, 
    [string]$mySecondaryVserver,
	[string]$myVolume) {
Try {
	$Return = $True
    Write-LogDebug "start"
	Write-LogDebug "[$Global:SVMTOOL_DB]"

        if ( ( Test-Path $Global:SVMTOOL_DB -pathType container ) -eq $false ) {
                if(!$IsWindows){
                    $Global:SVMTOOL_DB=$Global:SVMTOOL_DB -Replace "\\","/"    
                }
                $out=New-Item -Path $Global:SVMTOOL_DB -ItemType directory
                if ( ( Test-Path $Global:SVMTOOL_DB -pathType container ) -eq $false ) {
                        Write-LogError "ERROR: Unable to create new item $Global:SVMTOOL_DB" 
                        Write-LogDebug "end"
                        return $False
                }
        }
  	if ( $myVserver -eq $null ) { $myVserver = "*" }
  	if ( $myVolume -eq $null ) { $myVolume  = "*" } 

  	$Source=$myVserver + ':' + $myVolume 

  	$NcCluster = Get-NcCluster -Controller $myController
  	$SourceCluster = $NcCluster.ClusterName

    Write-LogDebug "Get-NcSnapmirrorDestination  -SourceVserver $myVserver -VserverContext $myVserver -DestinationVserver $mySecondaryVserver -Controller $myController"
    $relationlist=Get-NcSnapmirrorDestination  -SourceVserver $myVserver -VserverContext $myVserver -DestinationVserver $mySecondaryVserver -Controller $myController  -ErrorVariable ErrorVar
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcSnapmirrorDestination failed [$ErrorVar]" } 
  	if ( $relationlist -eq $null ) {
		Write-LogDebug "SnapMirror No Relations found" ;
        Write-LogDebug "end"
		return $True 
  	}
  	foreach ( $relation in $relationlist ) {
		$SourceVolume = $relation.SourceVolume
		$SourceVserver = $relation.SourceVserver
		$DestinationVolume = $relation.DestinationVolume
		$DestinationVserver = $relation.DestinationVserver
		$DestinationLocation = $relation.DestinationLocation
		$RelationshipType =$relation.RelationshipType
		if ( ( $RelationshipType -eq "data_protection" ) -and ( $SourceVserver -ne $DestinationVserver  )  ) {
            Write-LogDebug "Get-NcVserverPeer -Controller $myController -VserverContext $SourceVserver -PeerVserver $mySecondaryVserver"
			$NcVserverPeer=Get-NcVserverPeer -Controller $myController -VserverContext $SourceVserver -PeerVserver $mySecondaryVserver 
			$DestinationCluster=$NcVserverPeer.PeerCluster
			Write-LogDebug "[$SourceVserver] [$SourceVolume] -> [$DestinationCluster] [$DestinationVserver] [$DestinationVolume] [$RelationshipType]" ;
			$SVMTOOL_DB_SRC_CLUSTER=$Global:SVMTOOL_DB + '\' + $SourceCluster + '.cluster'
			$SVMTOOL_DB_SRC_VSERVER=$SVMTOOL_DB_SRC_CLUSTER + '\' +$SourceVserver + '.vserver'
            if(!$IsWindows){
                $SVMTOOL_DB_SRC_CLUSTER=$SVMTOOL_DB_SRC_CLUSTER -Replace "\\","/"
                $SVMTOOL_DB_SRC_VSERVER=$SVMTOOL_DB_SRC_VSERVER -Replace "\\","/"   
            }
        		if ( ( Test-Path $SVMTOOL_DB_SRC_CLUSTER -pathType container ) -eq $false ) {
                		$out=new-item -Path $SVMTOOL_DB_SRC_CLUSTER -ItemType directory
                		if ( ( Test-Path $SVMTOOL_DB_SRC_CLUSTER -pathType container ) -eq $false ) {
                        		Write-LogError "ERROR: Unable to create new item $SVMTOOL_DB_SRC_CLUSTER" 
                        		return $False
                		}
        		}

        		if ( ( Test-Path $SVMTOOL_DB_SRC_VSERVER -pathType container ) -eq $false ) {
                		$out=new-item -Path $SVMTOOL_DB_SRC_VSERVER -ItemType directory
                		if ( ( Test-Path $SVMTOOL_DB_SRC_VSERVER -pathType container ) -eq $false ) {
                        		Write-LogError "ERROR: Unable to create new item $SVMTOOL_DB_SRC_VSERVER" 
                        		return $False
                		}
        		}

			$SVMTOOL_DB_DST_CLUSTER=$Global:SVMTOOL_DB + '\' + $DestinationCluster + '.cluster'
			$SVMTOOL_DB_DST_VSERVER=$SVMTOOL_DB_DST_CLUSTER + '\' +$DestinationVserver + '.vserver'
            if(!$IsWindows){
                $SVMTOOL_DB_DST_CLUSTER=$SVMTOOL_DB_DST_CLUSTER -Replace "\\","/"
                $SVMTOOL_DB_DST_VSERVER=$SVMTOOL_DB_DST_VSERVER -Replace "\\","/"   
            }

        		if ( ( Test-Path $SVMTOOL_DB_DST_CLUSTER -pathType container ) -eq $false ) {
                		$out=new-item -Path $SVMTOOL_DB_DST_CLUSTER -ItemType directory
                		if ( ( Test-Path $SVMTOOL_DB_DST_CLUSTER -pathType container ) -eq $false ) {
                        		Write-LogError "ERROR: Unable to create new item $SVMTOOL_DB_DST_CLUSTER" 
                        		return $False
                		}
        		}

        		if ( ( Test-Path $SVMTOOL_DB_DST_VSERVER -pathType container ) -eq $false ) {
                		$out=new-item -Path $SVMTOOL_DB_DST_VSERVER -ItemType directory
                		if ( ( Test-Path $SVMTOOL_DB_DST_VSERVER -pathType container ) -eq $false ) {
                        		Write-LogError "ERROR: Unable to create new item $SVMTOOL_DB_DST_VSERVER" 
                        		return $False
                		}
        		}
		}
	}
    Write-LogDebug "end"
	return $Return
}
Catch {
    handle_error $_ $myVserver
	return $Return
    }
}

#############################################################################################
Function create_subdir (
    [NetApp.Ontapi.Filer.C.NcController] $myController,
    [string] $myVserver,
    [string] $Dirs,
    [string] $RootVolume,
    [NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
    [string] $myPrimaryVserver,
    [switch] $Restore)
{
    $Return=$True
    $fullpath=$("/vol/"+$RootVolume)
    foreach($dir in $Dirs.split("/")[1..$Dirs.split("/").count]){
        Write-LogDebug "Work with dir [$dir]"
        $fullpath+=$("/"+$dir)
        try{
            Write-LogDebug "Get dir detail for path [$fullpath] on [$myVserver]"
            try{
                $DirDetails=Read-NcDirectory -Path $fullpath -VserverContext $myVserver -Controller $myController -ErrorAction SilentlyContinue
            }catch{
                $DirDetails=$null
            }
            if($DirDetails -eq $null){
                Write-LogDebug "Get dir detail for path [$fullpath] on [$myPrimaryVserver]"
                $searchPath=(Split-Path -Path $fullpath).replace('\','/')
                if($Restore -eq $False){
                    $PrimDirDetails=Read-NcDirectory -Path $searchPath -VserverContext $myPrimaryVserver -Controller $myPrimaryController | Where-Object {$_.Name -eq $dir}
                }else{
                    if(Test-Path $($Global:JsonPath+"Read-NcDirectory-"+$dir+".json")){
                        $PrimDirDetails=Get-Content $($Global:JsonPath+"Read-NcDirectory-"+$dir+".json") -Raw | ConvertFrom-Json
                    }else{
                        $Return=$False
                        $filepath=$($Global:JsonPath+"Read-NcDirectory-"+$dir+".json")
                        Throw "ERROR: failed to read $filepath"
                    }    
                }
                $PrimDirPerm=$PrimDirDetails.Perm
                $PrimDirType=$PrimDirDetails.Type
                if($PrimDirType -eq "directory"){
                    Write-LogDebug "Create Sub Directory [$dir] on Secondary Vserver [$myVserver] inside volume [$RootVolume] at Path [$fullpath] with Perm [$PrimDirPerm]"
                    Write-LogDebug "New-NcDirectory -Controller $myController -VserverContext $mySecondaryVserver -Permission $PrimDirPerm -Path $fullpath"
                    $out=New-NcDirectory -Controller $mySecondaryController -VserverContext $mySecondaryVserver -Permission $PrimDirPerm -Path $fullpath -ErrorVariable ErrorVar -Confirm:$False
                    if($? -ne $True) { $Return = $False ; Throw "ERROR : Failed to create Sub Directory [$dir] on volume [$Root] on SVM [$myVserver] Reason : [$ErrorVar]" } 
                }elseif($PrimDirType -eq "symlink"){
                    Write-LogDebug "Create SymLink [$dir] on Secondary Vserver [$myVserver] inside volume [$RootVolume] with target [$fullpath]"
                    Write-LogError "Create symlink manually"
                    ## $out=New-NcSymLink -Controller $mySecondaryController -VserverContext $mySecondaryVserver -Permission $PrimDirPerm -Path $fullpath -ErrorVariable ErrorVar -Confirm:$False
                    ## if($? -ne $True) { $Return = $False ; Throw "ERROR : Failed to create Sub Directory [$dir] on volume [$Root] on SVM [$myVserver] Reason : [$ErrorVar]" }    
                }
            }else{
                Write-LogDebug "directory [$fullpath] aleready exist"
            }
        }catch{
            handle_error $_ $myVserver
            return $Return    
        }
    } 
    return $Return  
}

#############################################################################################
Function mount_volume (
    [NetApp.Ontapi.Filer.C.NcController] $myController,
    [string] $myVserver,
    [string] $myVolumeName,
    [NetApp.Ontapi.Filer.C.NcController] $myPrimaryController,
    [string] $myPrimaryVserver,
    [switch] $Restore,
    [bool] $IsFlexgroup=$False) 
{
    
    $Return = $True 
    Write-logDebug "start $myVolumeName"
    $RootVolume = (Get-NcVserver -Controller $myController -Vserver $myVserver  -ErrorVariable ErrorVar).RootVolume
	if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Get-NcVserver failed to get RootVolume [$ErrorVar]" } 
    if ($RootVolume -eq $null ) { Write-LogDebug "mount_volume()|root volume not found for [$myVserver]" }
    if($IsFlexgroup -eq $False){
        $FindVolume=$script:vol_junction | Where-Object {$_.Name -eq $myVolumeName}
    }else{
        $SourceFlexgroupVolumeName=$myVolumeNAme -Replace "_dst",""
        $FindVolume=$script:vol_junction | Where-Object {$_.Name -eq $SourceFlexgroupVolumeName}    
    }
    $Parent=$FindVolume.JunctionParent
    $JunctionPath=$FindVolume.JunctionPath
    $ParentPath=$FindVolume.ParentPath
    $Permission=$FindVolume.Permission
    $ParentPath=$FindVolume.ParentPath
    $IsNested=$FindVolume.IsNested
    $PathLevel=$FindVolume.Level
    Write-LogDebug "volume [$myVolumeName] Parent [$Parent] JunctionPath [$JunctionPath] Perm [$Permission] RootVol [$RootVolume] Level [$PathLevel] ParentPath [$ParentPath]"
    $mountpath=(Get-NcVol -Name $myVolumeName -Vserver $myVserver -Controller $myController).VolumeIdAttributes.JunctionPath
    if($mountpath -ne $null){
        Write-LogDebug "Volume [$myVolumeName] is mounted under [$mountpath]"
        if($mountpath -eq $JunctionPath){
            Write-LogDebug "Volume [$myVolumeName] is correctly mounted"
            Write-logDebug "end $myVolumeName"
            return $True
        }
    Write-LogDebug "First need to unmount volume [$myVolumeName] from [$mountpath] on [$myVserver]"
    Write-logDebug "Dismount-NcVol -Name $myVolumeName -VserverContext $myVserver -Controller $myController"
    $out=Dismount-NcVol -Name $myVolumeName -VserverContext $myVserver -Controller $myController -Force -Confirm:$False -ErrorVariable ErrorVar
    if ( $? -ne $True ) { $Return = $False ; throw "ERROR: Dismount-NcVol [$myVolumeName] failed [$ErrorVar]" }        
    }
    try{
        Write-LogDebug "Now will mount volume [$myVolumeName]"
        $voltype="rw"
        if($Parent -ne $RootVolume){
            $volType=(Get-NcVol -Controller $myController -Vserver $myVserver -Volume $myVolumeName).VolumeIdAttributes.Type
            if($volType -eq "dp" -and $Restore -eq $False){
                Write-LogDebug "Need to break all associated SM relationship with [$myVolumeName] before beeing able to create a directory inside this volume"
                Write-LogDebug "Invoke-NcSnapmirrorQuiesce -DestinationVserver $myVserver -DestinationVolume $myVolumeName -Controller $mySecondaryController"
                $ret=Invoke-NcSnapmirrorQuiesce -DestinationVserver $myVserver -DestinationVolume $myVolumeName -Controller $mySecondaryController -ErrorVariable ErrorVar -Confirm:$False
                if($? -ne $True){$Return=$False; Throw "ERROR : Failed to quiesce destination relationship [${mySecondaryController}:${mySecondaryVserver}:${PrimaryVol}] reason [$ErrorVar]"}
                $ret=wait_snapmirror_dr_status -DestinationVserver $myVserver -PrimaryVolumeName $myVolumeName -Status "quiesced" -MirrorState "snapmirrored" -mySecondaryController $mySecondaryController
                if($ret -eq $false){
                    $Return=$False
                    Throw "ERROR : Failed to quiesce a snapmirror relationship. Increase timeout?"
                }
                Write-LogDebug "Invoke-NcSnapmirrorBreak -Controller $myController -Confirm:$false -DestinationVserver $myVserver -DestinationVolume $myVolumeName" 
                $out=Invoke-NcSnapmirrorBreak -Controller $myController -Confirm:$false -DestinationVserver $myVserver -DestinationVolume $myVolumeName -ErrorVariable ErrorVar
                if($? -ne $True){throw "ERROR: Failed to break SM destination [$myVserver]:[$myVolumeName] on [$myController] reason [$ErrorVar]"}
            }
        }
        $CreatePath=(Split-Path -Path $JunctionPath).Replace('\','/')
        Write-LogDebug "CreatePath is [$CreatePath] for JunctionPath [$JunctionPath] for volume [$myVolumeName] inside Parent [$Parent]"
        if($CreatePath.Length -gt 1){
            Write-LogDebug "Need to Create all subdir in [$CreatePath]"
            if($FindVolume.IsNested -eq $True){   
                $RelativePathToCreate=$CreatePath.replace($ParentPath,"") 
                if($RelativePathToCreate.Length -gt 1){
                    if($Restore -eq $False){
                        Write-LogDebug "Treat subdir for a nested volume`nNeed to Create [$RelativePathToCreate] inside volume [$Parent]"
                        if(($ret=create_subdir -myController $myController -myVserver $myVserver -Dirs $RelativePathToCreate -RootVolume $Parent -myPrimaryController $myPrimaryController -myPrimaryVserver $myPrimaryVserver) -ne $True) {
                            Return $False
                            Throw "ERROR: Failed to create all subidr [$RelativePathToCreate] in [$Parent]"
                        }
                    }else{
                        Write-LogDebug "Treat subdir for a nested volume`nNeed to Create [$RelativePathToCreate] inside volume [$Parent]"
                        if(($ret=create_subdir -myController $myController -myVserver $myVserver -Dirs $RelativePathToCreate -RootVolume $Parent -Restore) -ne $True) {
                            Return $False
                            Throw "ERROR: Failed to create all subidr [$RelativePathToCreate] in [$Parent]"
                        }    
                    }
                }else{
                    Write-LogDebug "Don't need to create [$CreatePath], already present"
                }
            }else{
                if($Restore -eq $False){
                    Write-LogDebug "Treat subdir`nNeed to Create [$CreatePath] inside volume [$Parent]"
                    if(($ret=create_subdir -myController $myController -myVserver $myVserver -Dirs $CreatePath -RootVolume $Parent -myPrimaryController $myPrimaryController -myPrimaryVserver $myPrimaryVserver) -ne $True) {
                        Return $False
                        Throw "ERROR: Failed to create all subidr [$CreatePath] in [$Parent]"
                    }
                }else{
                    Write-LogDebug "Treat subdir`nNeed to Create [$CreatePath] inside volume [$Parent]"
                    if(($ret=create_subdir -myController $myController -myVserver $myVserver -Dirs $CreatePath -RootVolume $Parent -Restore) -ne $True) {
                        Return $False
                        Throw "ERROR: Failed to create all subidr [$CreatePath] in [$Parent]"
                    }    
                }
            }  
        }
        try{
            Write-logDebug "Mount-NcVol -Name $myVolumeName -JunctionPath $JunctionPath -VserverContext $myVserver -Controller $myController"
            $out=Mount-NcVol -Name $myVolumeName -JunctionPath $JunctionPath -VserverContext $myVserver -Controller $myController -ErrorVariable ErrorVar
            if ( $? -ne $True ) {throw "ERROR: Mount-NcVol [$myVolumeName] failed [$ErrorVar]" } 
        }catch{
            #wait-debugger
            $ErrorMessage = $_.Exception.Message
            Write-LogDebug "Catch Mount-NcVol Failed to mount trap [$ErrorMessage]"
        }
        if($voltype -eq "dp" -and $Restore -eq $False){
            Write-LogDebug "resync snapmirror previously broken"
            $ret=Invoke-NcSnapmirrorResync -DestinationVserver $myVserver -DestinationVolume $myVolumeName -Controller $myController -Confirm:$False -ErrorVariable ErrorVar  
            if($? -ne $True){throw "ERROR: Failed to resync SM destination [$myVserver]:[$myVolumeName] on [$myController] reason [$ErrorVar]"}  
        }
        #$ret=analyse_junction_path -myController $mySecondaryController -myVserver $mySecondaryVserver -Dest
        $ret=analyse_junction_path -myController $myController -myVserver $myVserver -Dest
        if ($ret -ne $True){$Return=$False;Throw "ERROR : Failed to analyse_junction_path"}
        Write-logDebug "end $myVolumeName"
        return $Return  
    }catch{
        handle_error $_ $myVserver
        return $Return    
    }                 
    Write-logDebug "end $myVolumeName"
    return $Return
}

